---
import config from '../data/config.json';
import '../styles/components/hero.css';
---

<section class="hero-section" id="home" aria-labelledby="hero-main-title">
  <!-- Architectural Blueprint Grid Texture Layer across the entire canvas -->
  <div class="hero-grid-texture" aria-hidden="true"></div>

  <!-- Interactive Pointer Spotlight & Blueprint Crosshairs (Option 1) -->
  <div class="hero-pointer-spotlight" aria-hidden="true"></div>
  <div class="hero-crosshairs-layer" aria-hidden="true"></div>

  <!-- Floating Luminous Aurora Orbs (Blurred ambient light fields) -->
  <div class="hero-aurora-wrapper" aria-hidden="true">
    <div class="aurora-orb aurora-green-1"></div>
    <div class="aurora-orb aurora-orange-1"></div>
    <div class="aurora-orb aurora-cyan-1"></div>
    <div class="aurora-orb aurora-amber-2"></div>
    <div class="aurora-orb aurora-emerald-2"></div>
  </div>

  <div class="container hero-content-container">
    <!-- Refined SEBI Registration Eyebrow -->
    <div class="hero-eyebrow animate-eyebrow" aria-label={`SEBI Registered Research Analyst ${config.sebiRegNo}`}>
      <span class="eyebrow-rule" aria-hidden="true"></span>
      <span class="eyebrow-text">
        SEBI REGISTERED RESEARCH ANALYST <span class="eyebrow-sep" aria-hidden="true">&middot;</span> {config.sebiRegNo}
      </span>
      <span class="eyebrow-rule" aria-hidden="true"></span>
    </div>

    <!-- Centered Editorial Headline with Smooth Staggered Flow-In Animation & Periodic Liquid Text Shine -->
    <h1 class="hero-title" id="hero-main-title">
      <!-- Line 1 -->
      <span class="line-mask">
        <span class="line-flow line-1 text-shine">Repeat a Pattern</span>
      </span>
      
      <!-- Line 2 -->
      <span class="line-mask">
        <span class="line-flow line-2 text-shine">Until It Becomes Your</span>
      </span>
      
      <!-- Line 3 (Glowing Gold Signature) -->
      <span class="line-mask signature-mask">
        <span class="line-flow line-3 signature-wrapper">
          <span class="signature-word">Signature.</span>
          <!-- Dynamic Glowing Gold Signature Line (Swiftly draws in right below Signature) -->
          <svg class="signature-flourish" aria-hidden="true" viewBox="0 0 320 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path 
              class="flourish-glow-path" 
              d="M 6,15 C 50,19 108,20 162,16 C 204,13 242,9 272,8 C 286,7.5 298,10 294,14 C 290,18 276,17 284,11 C 290,6.5 306,4 318,3.5" 
              stroke="#D4AF37" 
              stroke-width="2.5" 
              stroke-linecap="round" 
              stroke-linejoin="round" 
            />
          </svg>
        </span>
      </span>
    </h1>

    <!-- Single Exact Supporting Statement -->
    <p class="hero-support animate-support">
      Clarity. A deeper way of thinking about markets.
    </p>

    <!-- Primary CTA Button -->
    <div class="hero-action animate-cta">
      <a href="#offerings" class="btn-hero-primary" aria-label="Explore Our Research">
        <span>Explore Our Research</span>
      <span class="cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Mobile-Only Grounding Trust Pill (Active on screens <= 820px) -->
    <div class="hero-mobile-trust animate-mobile-trust" aria-label="Market Experience Highlight">
      <span class="trust-badge-dot" aria-hidden="true"></span>
      <span class="trust-val">7+ Yrs</span>
      <span class="trust-sep" aria-hidden="true">&bull;</span>
      <span class="trust-lbl">Market Experience</span>
    </div>
  </div>

  <!-- Desktop Architectural Side Telemetry Marks (Visible on >= 1200px screens) -->
  <div class="hero-flank hero-flank-left" aria-hidden="true">
    <span class="flank-coord">+ 19°04'N 72°52'E</span>
    <span class="flank-line"></span>
    <span class="flank-label">RESEARCH TERMINAL</span>
  </div>

  <div class="hero-flank hero-flank-right" aria-hidden="true">
    <span class="flank-label">DISCIPLINE &bull; EDGE</span>
    <span class="flank-line"></span>
    <span class="flank-coord">EST. MUMBAI +</span>
  </div>
</section>


<script src='../scripts/hero.ts'></script>
