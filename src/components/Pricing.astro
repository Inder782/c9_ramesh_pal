        </div>

        <!-- Standalone Clean WhatsApp Enrollment Button -->
        <div class="track-cta-container">
          <a 
            href={`${whatsappBase}${encodeURIComponent("Hi Ramesh Pal, I would like to enroll in the Master Trader 3-Month Mentorship Program (₹14,999).")}`} 
            target="_blank" 
            rel="noopener noreferrer" 
