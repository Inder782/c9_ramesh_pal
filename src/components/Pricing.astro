            </div>
          ))}
          <div class="mobile-track-stop">
            <div class="mobile-dot-col">
              <span class="mobile-dot dot-finish">🏁</span>
            </div>
            <div class="mobile-stop-info">
              <span class="mobile-stop-phase">Cohort Milestone</span>
              <h5 class="mobile-stop-title">Independent Trader Ready</h5>
              <p class="mobile-stop-desc">Audited trade plan, risk discipline &amp; lifetime mentorship access.</p>
