---
import config from '../data/config.json';
const whatsappBase = `https://wa.me/${config.whatsappPhone}?text=`;

const advisoryPlans = [
  {
    id: "equity-cash",
    category: "Cash Market",
    title: "Equity Cash Segment Desk",
    badge: "Most Versatile",
    popular: false,
    cardClass: "card-cash-market",
    description: "Structured delivery and short-swing recommendations for disciplined equity investors and capital compounders.",
    specs: [
      { label: "Frequency", value: "5–6 Ideas / Week" },
      { label: "Holding Horizon", value: "1 to 8 Weeks" },
      { label: "Scanners", value: "Volume Contraction & Breakouts" }
    ],
    pricing: [
      { period: "Weekly", fee: "₹5,000", tag: "Trial" },
      { period: "Monthly", fee: "₹15,000", tag: "Standard" },
      { period: "Quarterly", fee: "₹40,000", tag: "Best Value" }
    ],
    features: [
      "5–6 high-conviction cash equity setups per week",
      "Explicit entry price, target levels, and strict stop-loss",
      "In-depth rationale with chart setup & sector momentum context",
      "Real-time update alerts via private communication desk"
    ],
    ctaText: "Enquire for Equity Cash",
    whatsappMsg: "Hi Ramesh Pal, I am interested in subscribing to the Equity Cash Segment Desk."
  },
  {
    id: "index-fno",
    category: "Derivatives",
    title: "Index Options & Futures Desk",
    badge: "Highest Demand",
    popular: true,
    cardClass: "card-highest-demand",
    description: "High-probability derivative setups focused purely on liquid indices with disciplined Greeks profiling.",
    specs: [
      { label: "Indices", value: "Nifty 50, Bank Nifty, Fin Nifty" },
      { label: "Risk-Reward", value: "Strict 1:2 to 1:3 R:R" },
      { label: "Methodology", value: "Option Chain & Delta Analysis" }
    ],
    pricing: [
      { period: "Weekly", fee: "₹3,500", tag: "Intro" },
      { period: "Monthly", fee: "₹10,000", tag: "Active" },
      { period: "Quarterly", fee: "₹25,000", tag: "Save ₹5,000" }
    ],
    features: [
      "Liquid Index futures and options setups (Nifty, Bank Nifty)",
      "Defined-risk strike selection & Option Greeks awareness",
      "Strict 1:2 to 1:3 risk-to-reward ratio with position sizing",
      "Live market execution updates and trailing stop-loss guidance"
    ],
    ctaText: "Subscribe to Index F&O",
    whatsappMsg: "Hi Ramesh Pal, I would like to join the Index Options & Futures Desk."
  },
  {
    id: "short-swing",
    category: "Technical Momentum",
    title: "Short-Term Swing Trading",
    badge: "Tactical Desk",
    popular: false,
    cardClass: "card-tech-momentum",
    description: "Fast-paced momentum setups capturing explosive volatility contractions and chart pattern expansions.",
    specs: [
      { label: "Holding Period", value: "< 7 Trading Days" },
      { label: "Tools", value: "Chartink & TradingView Scanners" },
      { label: "Target Alpha", value: "Tactical Alpha Swings" }
    ],
    pricing: [
      { period: "3 Months (Quarterly)", fee: "₹10,000", tag: "Cohort" }
    ],
    features: [
      "Holding horizon strictly under 7 trading days",
      "Screened via custom Chartink & TradingView momentum scanners",
      "Predefined stop-loss and dual target profit milestones",
      "Weekend post-market pattern audit and setup retrospective"
    ],
    ctaText: "Join Short-Term Swing",
    whatsappMsg: "Hi Ramesh Pal, I am interested in the Short-Term Swing Trading advisory plan."
  },
  {
    id: "long-term",
    category: "Fundamental Wealth",
    title: "Long-Term Wealth Portfolio",
    badge: "Structural Compounding",
    popular: false,
    cardClass: "",
    description: "Multi-year wealth compounders identified through fundamental DCF modeling, competitive moats, and economic moats.",
    specs: [
      { label: "Holding Period", value: "> 6 Months" },
      { label: "Framework", value: "E-I-C & DCF Valuation" },
      { label: "Focus", value: "High ROCE & Strong Balance Sheet" }
    ],
    pricing: [
      { period: "3 Months (Quarterly)", fee: "₹12,000", tag: "Portfolio" }
    ],
    features: [
      "High-conviction structural compounders with 6+ months horizon",
      "Detailed fundamental research notes covering moats and governance",
      "DCF valuation models and quarterly balance sheet updates",
      "Periodic rebalancing alerts to optimize capital allocation"
    ],
    ctaText: "Apply for Wealth Portfolio",
    whatsappMsg: "Hi Ramesh Pal, I want to subscribe to the Long-Term Wealth Portfolio advisory service."
  },
  {
    id: "institutional-reports",
    category: "Institutional Grade",
    title: "Equity Valuation & IPO Reports",
    badge: "Bespoke Research",
    popular: false,
    cardClass: "",
    description: "Deep-dive institutional equity valuation dossiers, IPO pre-listing evaluations, and sector whitepapers.",
    specs: [
      { label: "Coverage", value: "BSE / NSE Equities & IPOs" },
      { label: "Depth", value: "Institutional Forensic Reports" },
      { label: "Audience", value: "HNIs, Family Offices & Corporates" }
    ],
    pricing: [
      { period: "Annual Coverage", fee: "₹30,000 – ₹60,000", tag: "Annual" }
    ],
    features: [
      "In-depth research notes on emerging mid-cap and small-cap leaders",
      "Thorough IPO evaluation notes with fair value ranges and risk flags",
      "Forensic accounting review (Cash flow vs EBITDA)",
      "Direct consultation access with Ramesh Pal on institutional coverage"
    ],
    ctaText: "Request Institutional Dossier",
    whatsappMsg: "Hi Ramesh Pal, I would like to enquire about Institutional Equity Research & IPO Reports."
  }
];

const syllabusCol1 = [
  { num: "01", title: "Equity Market & Stock Exchanges (NSE/BSE)" },
  { num: "02", title: "Demat & Order Types (SL, SL-M, GTT)" },
  { num: "03", title: "Fundamental Analysis & E-I-C Framework" },
  { num: "04", title: "Price Action, Patterns, EMA & VWAP" }
];

const syllabusCol2 = [
  { num: "05", title: "Futures, Options & Greeks (Delta, Theta)" },
  { num: "06", title: "MCX Commodities (Crude, Gold, Silver)" },
  { num: "07", title: "Intraday Breakouts (ORB) & Scalping" },
  { num: "08", title: "Mutual Funds & Long-Term Compounding" }
];

const syllabusCol3 = [
  { num: "09", title: "Trading Psychology & Emotional Equanimity" },
  { num: "10", title: "Weekly Live Setup Teardowns & Q&A" },
  { num: "11", title: "Lifetime Mentorship Community Access" }
];
---

<section class="pricing-section" id="offerings" aria-labelledby="pricing-heading">
  <div class="container">
    <!-- Header -->
    <div class="section-head reveal-on-scroll">
      <h2 id="pricing-heading" class="section-title">Offerings &amp; Pricing</h2>
      <p class="section-lead">
        Disciplined research advisory and structured market mentorship with complete regulatory transparency.
      </p>
    </div>

    <!-- 2-Way Interactive Segmented Control Toggle -->
    <div class="toggle-container reveal-on-scroll">
      <div class="segmented-control" role="tablist" aria-label="Offerings View Toggle">
        <button 
          id="tab-btn-advisory" 
          class="seg-btn active" 
          role="tab" 
          aria-selected="true" 
          aria-controls="panel-advisory"
          tabindex="0"
          type="button"
        >
          <svg class="tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            <polyline points="17 6 23 6 23 12"></polyline>
          </svg>
          <span>Research Advisory Plans</span>
          <span class="tab-micro-pill">SEBI Reg.</span>
        </button>

        <button 
          id="tab-btn-courses" 
          class="seg-btn" 
          role="tab" 
          aria-selected="false" 
          aria-controls="panel-courses"
          tabindex="-1"
          type="button"
        >
          <svg class="tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <span>Courses &amp; Trading Academy</span>
          <span class="tab-micro-pill academy-pill">1 Mo + 2 Mo Practice</span>
        </button>
      </div>
    </div>

    <!-- PANEL 1: RESEARCH ADVISORY PLANS -->
    <div 
      id="panel-advisory" 
      class="tab-panel active-panel" 
      role="tabpanel" 
      aria-labelledby="tab-btn-advisory"
    >
      <!-- Advisory Plans Grid -->
      <div class="advisory-grid">
        {advisoryPlans.map((plan) => (
          <div class={`advisory-card ${plan.popular ? 'card-popular' : ''} ${plan.cardClass} reveal-on-scroll`}>
            {plan.popular && (
              <div class="popular-ribbon">
                <span>{plan.badge}</span>
              </div>
            )}
            
            <div class="card-tier-head">
              <span class="tier-category">{plan.category}</span>
              <h3 class="tier-name">{plan.title}</h3>
              <p class="tier-desc">{plan.description}</p>
            </div>

            <!-- Key Specs Bar -->
            <div class="specs-grid">
              {plan.specs.map((sp) => (
                <div class="spec-cell">
                  <span class="spec-label">{sp.label}</span>
                  <span class="spec-val">{sp.value}</span>
                </div>
              ))}
            </div>

            <!-- Fee Schedule -->
            <div class="pricing-schedule">
              <div class="sched-heading">Fee Schedule</div>
              <div class="fee-rows">
                {plan.pricing.map((pr) => (
                  <div class="fee-row">
                    <div class="fee-period-wrap">
                      <span class="fee-period">{pr.period}</span>
                      {pr.tag && <span class="fee-tag">{pr.tag}</span>}
                    </div>
                    <span class="fee-amount">{pr.fee}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Feature Bullet Points -->
            <div class="card-features-block">
              <ul class="features-list">
                {plan.features.map((feat) => (
                  <li>
                    <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action CTA Button -->
            <div class="card-action">
              <a 
                href={`${whatsappBase}${encodeURIComponent(plan.whatsappMsg)}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class={`action-btn ${plan.popular ? 'btn-primary' : 'btn-secondary'}`}
              >
                <span>{plan.ctaText}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- PANEL 2: COURSES & TRADING ACADEMY (CLEAN, AIRY LAYOUT WITHOUT HEAVY BOXES) -->
    <div 
      id="panel-courses" 
      class="tab-panel hidden-panel" 
      role="tabpanel" 
      aria-labelledby="tab-btn-courses"
    >
      <div class="courses-open-layout reveal-on-scroll">
        <!-- Clean Header -->
        <div class="courses-open-header">
          <div class="flagship-top-badge">Flagship Mentorship Program</div>
          <h3 class="courses-open-title">Master Trader 3-Month Mentorship Program</h3>
          <p class="courses-open-model">
            1 Month Live Interactive Masterclasses &bull; 2 Months Live Market Practice &amp; Personal Doubt Clearing
          </p>
          <p class="courses-open-lead">
            A comprehensive curriculum taking you from foundational chart mechanics to independent, risk-controlled trading across Equities, Derivatives, and Commodities with direct mentorship from Ramesh Pal.
          </p>
        </div>

        <!-- 11 Modules Structured Across 3 Clean Columns -->
        <div class="syllabus-columns-wrapper">
          <h4 class="syllabus-block-title">Comprehensive 11-Module Syllabus Coverage</h4>
          
          <div class="syllabus-three-columns">
            <!-- Column 1: Modules 01 - 04 -->
            <div class="syllabus-col">
              {syllabusCol1.map((item) => (
                <div class="syllabus-item">
                  <span class="syllabus-item-num">{item.num}</span>
                  <span class="syllabus-item-title">{item.title}</span>
                </div>
              ))}
            </div>

            <!-- Column 2: Modules 05 - 08 -->
            <div class="syllabus-col">
              {syllabusCol2.map((item) => (
                <div class="syllabus-item">
                  <span class="syllabus-item-num">{item.num}</span>
                  <span class="syllabus-item-title">{item.title}</span>
                </div>
              ))}
            </div>

            <!-- Column 3: Modules 09 - 11 -->
            <div class="syllabus-col">
              {syllabusCol3.map((item) => (
                <div class="syllabus-item">
                  <span class="syllabus-item-num">{item.num}</span>
                  <span class="syllabus-item-title">{item.title}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Standalone Clean Button (No Heavy Enclosing Box) -->
        <div class="courses-cta-container">
          <a 
            href={`${whatsappBase}${encodeURIComponent("Hi Ramesh Pal, I would like to apply for the Master Trader 3-Month Mentorship Program.")}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-apply-flagship"
          >
            <span>Apply for Flagship Mentorship via WhatsApp</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Zero-Lag Segmented Control Toggle Script -->
<script is:inline>
  function setupPricingToggle() {
    const btnAdvisory = document.getElementById('tab-btn-advisory');
    const btnCourses = document.getElementById('tab-btn-courses');
    const panelAdvisory = document.getElementById('panel-advisory');
    const panelCourses = document.getElementById('panel-courses');

    if (!btnAdvisory || !btnCourses || !panelAdvisory || !panelCourses) return;

    function switchTab(target) {
      if (target === 'courses') {
        btnAdvisory.classList.remove('active');
        btnAdvisory.setAttribute('aria-selected', 'false');
        btnAdvisory.setAttribute('tabindex', '-1');

        btnCourses.classList.add('active');
        btnCourses.setAttribute('aria-selected', 'true');
        btnCourses.setAttribute('tabindex', '0');

        panelAdvisory.classList.remove('active-panel');
        panelAdvisory.classList.add('hidden-panel');

        panelCourses.classList.remove('hidden-panel');
        panelCourses.classList.add('active-panel');
      } else {
        btnCourses.classList.remove('active');
        btnCourses.setAttribute('aria-selected', 'false');
        btnCourses.setAttribute('tabindex', '-1');

        btnAdvisory.classList.add('active');
        btnAdvisory.setAttribute('aria-selected', 'true');
        btnAdvisory.setAttribute('tabindex', '0');

        panelCourses.classList.remove('active-panel');
        panelCourses.classList.add('hidden-panel');

        panelAdvisory.classList.remove('hidden-panel');
        panelAdvisory.classList.add('active-panel');
      }
    }

    btnAdvisory.addEventListener('click', () => switchTab('advisory'));
    btnCourses.addEventListener('click', () => switchTab('courses'));

    btnAdvisory.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        btnCourses.focus();
        switchTab('courses');
      }
    });

    btnCourses.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        btnAdvisory.focus();
        switchTab('advisory');
      }
    });

    if (window.location.hash === '#courses' || window.location.hash === '#academy') {
      switchTab('courses');
    }
  }

  document.addEventListener('DOMContentLoaded', setupPricingToggle);
  setupPricingToggle();
</script>

<style>
  .pricing-section {
    padding: 64px 0 80px 0;
    background-color: var(--bg-tertiary);
  }

  .section-head {
    max-width: 760px;
    margin: 0 auto 36px auto;
    text-align: center;
  }

  .section-title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .section-lead {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Segmented Control Toggle */
  .toggle-container {
    display: flex;
    justify-content: center;
    margin-bottom: 48px;
  }

  .segmented-control {
    display: inline-flex;
    background: var(--bg-secondary);
    padding: 5px;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    gap: 6px;
    max-width: 100%;
  }

  .seg-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .seg-btn:hover {
    color: var(--text-primary);
  }

  .seg-btn.active {
    background: var(--accent-primary);
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(6, 78, 59, 0.25);
  }

  .seg-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .tab-icon {
    flex-shrink: 0;
  }

  .tab-micro-pill {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.2);
    color: currentColor;
  }

  .seg-btn:not(.active) .tab-micro-pill {
    background: var(--bg-tertiary);
    color: var(--text-muted);
  }

  /* Panels */
  .tab-panel {
    transition: opacity 0.25s ease;
  }

  .active-panel {
    display: block;
    animation: fadeIn 0.3s ease forwards;
  }

  .hidden-panel {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Advisory Cards Grid */
  .advisory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 24px;
  }

  .advisory-card {
    background: var(--bg-secondary);
    border-radius: 20px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    border: 1.5px solid transparent;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .advisory-card:hover {
    transform: translateY(-6px);
  }

  /* Glowing Borders on Specific Cards */
  /* 1. Highest Demand (Index F&O): Vibrant Emerald Glowing Border */
  .card-highest-demand {
    border: 2px solid #10B981;
    box-shadow: 0 0 24px rgba(16, 185, 129, 0.25), 0 8px 32px rgba(6, 78, 59, 0.12);
  }

  .card-highest-demand:hover {
    border-color: #34D399;
    box-shadow: 0 0 32px rgba(16, 185, 129, 0.4), 0 16px 40px rgba(6, 78, 59, 0.18);
  }

  /* 2. Cash Market: Glowing Pine / Emerald Accent Border */
  .card-cash-market {
    border: 1.5px solid rgba(6, 78, 59, 0.35);
    box-shadow: 0 0 18px rgba(6, 78, 59, 0.12), 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .card-cash-market:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 0 26px rgba(6, 78, 59, 0.24), 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  /* 3. Technical Momentum: Glowing Amber / Bronze Accent Border */
  .card-tech-momentum {
    border: 1.5px solid rgba(217, 119, 6, 0.4);
    box-shadow: 0 0 18px rgba(217, 119, 6, 0.15), 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .card-tech-momentum:hover {
    border-color: #D97706;
    box-shadow: 0 0 26px rgba(217, 119, 6, 0.3), 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .popular-ribbon {
    position: absolute;
    top: -12px;
    left: 24px;
    background: #10B981;
    color: #0E161B;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 9999px;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
  }

  .card-tier-head {
    margin-bottom: 16px;
  }

  .tier-category {
    display: inline-block;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
    margin-bottom: 6px;
  }

  .tier-name {
    font-size: 1.25rem;
    margin: 0 0 8px 0;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .tier-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    min-height: 40px;
  }

  /* Specs Grid */
  .specs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    background: var(--bg-tertiary);
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 20px;
  }

  .spec-cell {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7875rem;
  }

  .spec-label {
    color: var(--text-muted);
  }

  .spec-val {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Pricing Schedule */
  .pricing-schedule {
    margin-bottom: 20px;
    padding: 14px;
    border-radius: 12px;
    background: #FAF9F5;
  }

  .sched-heading {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .fee-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fee-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .fee-period-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .fee-period {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-weight: 500;
