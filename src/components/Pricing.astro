      weekly: { fee: "₹12,000", cycle: "/ 3 months", note: "Quarterly Desk Only" },
      monthly: { fee: "₹12,000", cycle: "/ 3 months", note: "Quarterly Desk Only" },
      quarterly: { fee: "₹12,000", cycle: "/ 3 months", note: "Structural Portfolio" }
    },
    features: [
      "High-conviction structural compounders",
      "Fundamental notes on moats & governance",
      "DCF valuation & balance sheet audits",
      "Periodic allocation rebalancing alerts"
    ],
    ctaText: "Apply for Wealth",
    whatsappMsg: "Hi Ramesh Pal, I want to subscribe to the Long-Term Wealth Portfolio advisory service."
  },
  {
    id: "institutional-reports",
    category: "Institutional",
    title: "Valuation & IPO Reports",
    badge: "Bespoke",
    popular: false,
    accentColor: "#B45309",
    description: "Institutional equity valuation dossiers, IPO evaluations & whitepapers.",
    specs: [
      { label: "Coverage", value: "BSE / NSE Equities" },
      { label: "Depth", value: "Forensic Dossiers" },
      { label: "Audience", value: "HNIs & Corporates" }
    ],
    pricing: {
      weekly: { fee: "₹30K – ₹60K", cycle: "/ year", note: "Annual Desk Only" },
      monthly: { fee: "₹30K – ₹60K", cycle: "/ year", note: "Annual Desk Only" },
      quarterly: { fee: "₹30K – ₹60K", cycle: "/ year", note: "Annual Research Retainer" }
    },
