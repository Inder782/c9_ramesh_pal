      monthly: { fee: "₹10,000", cycle: "/ month", note: "Active Traders" },
      quarterly: { fee: "₹25,000", cycle: "/ 3 months", note: "Save ₹5,000" }
    },
    features: [
      "Liquid Nifty & Bank Nifty F&O setups",
      "Defined-risk strike selection & Greeks",
      "Strict 1:2 to 1:3 asymmetric R:R",
      "Real-time market trailing guidance"
    ],
    ctaText: "Join Index Desk",
    whatsappMsg: "Hi Ramesh Pal, I would like to join the Index Options & Futures Desk."
  },
  {
    id: "short-swing",
    category: "Technical Momentum",
    title: "Short-Term Swing Trading",
    badge: "Tactical",
    popular: false,
    accentColor: "#D97706",
    description: "Fast momentum capturing explosive volatility contractions & expansions.",
    specs: [
      { label: "Holding", value: "< 7 Trading Days" },
      { label: "Tools", value: "Chartink Scanners" },
      { label: "Target", value: "Tactical Alpha" }
    ],
    pricing: {
      weekly: { fee: "₹10,000", cycle: "/ 3 months", note: "Quarterly Cohort Only" },
      monthly: { fee: "₹10,000", cycle: "/ 3 months", note: "Quarterly Cohort Only" },
      quarterly: { fee: "₹10,000", cycle: "/ 3 months", note: "Complete Swing Cohort" }
    },
    features: [
      "Holding strictly under 7 trading days",
      "Screened via custom Chartink scanners",
      "Predefined stop-loss & dual targets",
      "Weekend post-market pattern audit"
    ],
    ctaText: "Join Swing Desk",
    whatsappMsg: "Hi Ramesh Pal, I am interested in the Short-Term Swing Trading advisory plan."
  },
  {
    id: "long-term",
    category: "Fundamental Wealth",
    title: "Long-Term Wealth Portfolio",
    badge: "Compounding",
    popular: false,
    accentColor: "#0284C7",
    description: "Multi-year wealth compounders identified via fundamental DCF valuation.",
    specs: [
      { label: "Holding", value: "> 6 Months" },
      { label: "Framework", value: "E-I-C & DCF" },
      { label: "Focus", value: "High ROCE & Moats" }
    ],
