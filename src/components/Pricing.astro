              </div>
            </div>
          </div>
        </div>

        <!-- MOBILE STREAMLINED VERTICAL TRACK VIEW (< 960px) -->
        <div class="mobile-vertical-track" aria-label="Course Modules Mobile View">
          {courseTrackModules.map((m) => (
            <div class="mobile-track-stop">
              <div class="mobile-dot-col">
                <span class={`mobile-dot ${m.row === 2 ? 'dot-amber' : m.row === 3 ? 'dot-gold' : ''}`}>
                  {m.num}
