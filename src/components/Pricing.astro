---
import config from '../data/config.json';
const whatsappBase = `https://wa.me/${config.whatsappPhone}?text=`;
---

<section class="pricing-section" id="offerings" aria-labelledby="pricing-heading">
  <div class="container">
    <div class="section-head reveal-on-scroll">
      <div class="badge-pill">Transparent Research Plans</div>
      <h2 id="pricing-heading" class="section-title">
        Systematic Research &amp; Advisory Offerings
      </h2>
      <p class="section-lead">
        Institutional-quality equity research delivered with pedagogical clarity. Zero profit-sharing, zero opaque lock-ins, and zero speculative claims.
      </p>
    </div>

    <!-- Pricing / Plans Grid -->
    <div class="pricing-grid">
      <!-- Plan 1: Core Positional -->
      <div class="pricing-card reveal-on-scroll">
        <div class="card-tier-head">
          <span class="tier-pill">Positional Compounding</span>
          <h3 class="tier-title">Core Equity Desk</h3>
          <p class="tier-desc">Multi-month structural compounding for working professionals and disciplined investors.</p>
        </div>

        <div class="tier-price-block">
          <div class="price-val">₹14,999<span class="price-cycle"> / 6 Months</span></div>
          <span class="price-sub">₹24,999 / Annual (Save 17%)</span>
        </div>

        <ul class="features-list" aria-label="Core Equity Desk Features">
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>12–15 high-conviction structural compounders annually</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Comprehensive research notes with fundamental rationale</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Holding timeframe: 3 to 12 months</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Periodic rebalancing &amp; risk invalidation alerts</span>
          </li>
        </ul>

        <div class="card-action">
          <a href={`${whatsappBase}${encodeURIComponent("Hi Ramesh Pal, I am interested in subscribing to the Core Equity Desk.")}`} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full">
            Enquire for Core Desk
          </a>
        </div>
      </div>

      <!-- Plan 2: Signature Momentum (Featured) -->
      <div class="pricing-card featured-card reveal-on-scroll">
        <div class="featured-ribbon">Most Popular</div>
        <div class="card-tier-head">
          <span class="tier-pill featured-pill">Pattern Breakouts</span>
          <h3 class="tier-title">Signature Momentum Desk</h3>
          <p class="tier-desc">High-probability swing setups capturing momentum bursts and volatility contractions.</p>
        </div>

        <div class="tier-price-block">
          <div class="price-val">₹19,999<span class="price-cycle"> / 6 Months</span></div>
          <span class="price-sub">₹34,999 / Annual (Save 15%)</span>
        </div>

        <ul class="features-list" aria-label="Signature Momentum Desk Features">
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>3–5 curated swing ideas per month</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Precise entry triggers &amp; hard stop-loss levels</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Holding timeframe: 2 to 8 weeks</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Real-time Telegram channel updates &amp; trade tracking</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Strict 1:3 minimum risk-to-reward profiling</span>
          </li>
        </ul>

        <div class="card-action">
          <a href={`${whatsappBase}${encodeURIComponent("Hi Ramesh Pal, I would like to join the Signature Momentum Desk.")}`} target="_blank" rel="noopener noreferrer" class="btn-primary w-full">
            Join Momentum Desk
          </a>
        </div>
      </div>

      <!-- Plan 3: Complete Mentorship & Advisory Desk -->
      <div class="pricing-card reveal-on-scroll">
        <div class="card-tier-head">
          <span class="tier-pill">Full Pedagogical Access</span>
          <h3 class="tier-title">Mastery Desk &amp; Mentorship</h3>
          <p class="tier-desc">Dual desk access paired with weekly live webinars, setup deconstructions, and 1-on-1 interaction.</p>
        </div>

        <div class="tier-price-block">
          <div class="price-val">₹49,999<span class="price-cycle"> / Annual</span></div>
          <span class="price-sub">Exclusive cohort limited to 50 participants</span>
        </div>

        <ul class="features-list" aria-label="Mastery Desk Features">
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Full access to BOTH Core and Momentum Desks</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Weekly pedagogical webinars dissecting executed patterns</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Direct query resolution channel with Ramesh Pal</span>
          </li>
          <li>
            <svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="sr-only">Included:</span>
            <span>Access to past pattern study library &amp; case archives</span>
          </li>
        </ul>

        <div class="card-action">
          <a href={`${whatsappBase}${encodeURIComponent("Hi Ramesh Pal, I would like to apply for the Mastery Desk & Mentorship.")}`} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full">
            Apply for Cohort
          </a>
        </div>
      </div>
    </div>

    <!-- Statutory Disclaimer Note -->
    <div class="statutory-pricing-disclaimer reveal-on-scroll">
      <p>
        <strong>Mandatory Regulatory Notice:</strong> Investment in securities market are subject to market risks. Read all scheme related documents carefully before investing. Fee charged is solely for independent research analysis services in compliance with SEBI (Research Analysts) Regulations, 2014. There are no assured returns, profit-sharing models, or guaranteed outcomes.
      </p>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: 100px 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .section-head {
    max-width: 760px;
    margin: 0 auto 64px auto;
    text-align: center;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin: 16px 0 20px 0;
    letter-spacing: -0.02em;
  }

  .section-lead {
    font-size: 1.125rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: stretch;
    margin-bottom: 48px;
  }

  .pricing-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: 20px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .featured-card {
    background: #FFFFFF;
    border: 2px solid var(--accent-primary);
    box-shadow: var(--shadow-lg);
  }

  .featured-ribbon {
    position: absolute;
    top: -12px;
    right: 28px;
    background: var(--accent-primary);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-tier-head {
    margin-bottom: 24px;
  }

  .tier-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .featured-pill {
    color: var(--accent-primary);
  }

  .tier-title {
    font-size: 1.5rem;
    margin: 0 0 8px 0;
  }

  .tier-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  .tier-price-block {
    padding: 20px 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 24px;
  }

  .price-val {
    font-family: 'Lora', Georgia, serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .price-cycle {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .price-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--accent-primary);
    font-weight: 600;
    margin-top: 6px;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .check-icon {
    width: 18px;
    height: 18px;
    color: var(--accent-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-action {
    margin-top: auto;
  }

  .w-full {
    width: 100%;
  }

  .statutory-pricing-disclaimer {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 16px 20px;
    text-align: center;
  }

  .statutory-pricing-disclaimer p {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 960px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
