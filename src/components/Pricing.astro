---
import config from '../data/config.json';
import pricingData from '../data/pricing.json';
import '../styles/components/pricing.css';

const { advisoryPlans, courseTrackModules } = pricingData;
const whatsappBase = `https://wa.me/${config.whatsappPhone}?text=`;

const row1Stations = courseTrackModules.filter(m => m.row === 1);
const row2StationsReversed = [courseTrackModules[7], courseTrackModules[6], courseTrackModules[5], courseTrackModules[4]];
const row3Stations = courseTrackModules.filter(m => m.row === 3);
---

<section class="pricing-section" id="offerings" aria-labelledby="pricing-heading">
  <div class="container offerings-container">
    <!-- Header -->
    <div class="section-head reveal-on-scroll">
      <h2 id="pricing-heading" class="section-title">Offerings &amp; Pricing</h2>
      <p class="section-lead">
        Disciplined research advisory and structured market mentorship with complete regulatory transparency.
      </p>
    </div>

    <!-- 2-Way Interactive Segmented Control Toggle -->
    <div class="toggle-container reveal-on-scroll">
      <div class="segmented-control" role="tablist" aria-label="Offerings View Toggle">
        <button 
          id="tab-btn-advisory" 
          class="seg-btn active" 
          role="tab" 
          aria-selected="true" 
          aria-controls="panel-advisory"
          tabindex="0"
          type="button"
        >
          <svg class="tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            <polyline points="17 6 23 6 23 12"></polyline>
          </svg>
          <span>Research Advisory Plans</span>
        </button>

        <button 
          id="tab-btn-courses" 
          class="seg-btn" 
          role="tab" 
          aria-selected="false" 
          aria-controls="panel-courses"
          tabindex="-1"
          type="button"
        >
          <svg class="tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <span>Courses &amp; Trading Academy</span>
        </button>
      </div>
    </div>

    <!-- PANEL 1: RESEARCH ADVISORY PLANS (OPTION 1: FINTECH COMPARISON STRIP WITH BILLING SWITCHER) -->
    <div 
      id="panel-advisory" 
      class="tab-panel active-panel" 
      role="tabpanel" 
      aria-labelledby="tab-btn-advisory"
    >
      <!-- Global Billing Duration Switcher -->
      <div class="billing-switcher-bar reveal-on-scroll">
        <span class="switcher-label">Subscription Billing Cycle:</span>
        <div class="billing-pills" role="radiogroup" aria-label="Billing cycle selector">
          <button type="button" class="billing-pill" data-cycle="weekly" role="radio" aria-checked="false">
            Weekly
          </button>
          <button type="button" class="billing-pill" data-cycle="monthly" role="radio" aria-checked="false">
            Monthly
          </button>
          <button type="button" class="billing-pill active" data-cycle="quarterly" role="radio" aria-checked="true">
            Quarterly (Best Value)
          </button>
        </div>
      </div>

      <!-- Advisory 5-Plan Strip (Desktop: 5-Col Grid; Mobile: Infinite Smooth Flowing Ticker with Tap-to-Read) -->
      <div class="advisory-strip-viewport" id="advisory-viewport">
        <div class="advisory-strip" id="advisory-strip">
          {advisoryPlans.map((plan) => (
            <div 
              class={`strip-card ${plan.popular ? 'card-featured' : ''} reveal-on-scroll`}
              data-plan-id={plan.id}
            >
              {plan.popular && (
                <div class="card-ribbon">
                  <span>{plan.badge}</span>
                </div>
              )}
              
              <div class="strip-card-top">
                <span class="plan-cat-badge">{plan.category}</span>
                <h3 class="plan-card-title">{plan.title}</h3>
                <p class="plan-card-desc">{plan.description}</p>
              </div>

              <!-- Dynamic Price Block Updated by JS Switcher -->
              <div class="strip-price-block">
                <div class="price-line">
                  <span 
                    class="price-number" 
                    data-price-weekly={plan.pricing.weekly.fee}
                    data-price-monthly={plan.pricing.monthly.fee}
                    data-price-quarterly={plan.pricing.quarterly.fee}
                  >
                    {plan.pricing.quarterly.fee}
                  </span>
                  <span 
                    class="price-period"
                    data-period-weekly={plan.pricing.weekly.cycle}
                    data-period-monthly={plan.pricing.monthly.cycle}
                    data-period-quarterly={plan.pricing.quarterly.cycle}
                  >
                    {plan.pricing.quarterly.cycle}
                  </span>
                </div>
                <span 
                  class="price-note"
                  data-note-weekly={plan.pricing.weekly.note}
                  data-note-monthly={plan.pricing.monthly.note}
                  data-note-quarterly={plan.pricing.quarterly.note}
                >
                  {plan.pricing.quarterly.note}
                </span>
              </div>

              <!-- Specs Mini Table -->
              <div class="specs-mini-table">
                {plan.specs.map((sp) => (
                  <div class="spec-row">
                    <span class="spec-k">{sp.label}</span>
                    <span class="spec-v">{sp.value}</span>
                  </div>
                ))}
              </div>

              <!-- Features Bullet List -->
              <ul class="strip-features">
                {plan.features.map((feat) => (
                  <li>
                    <svg class="check-bullet" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <!-- CTA Button -->
              <div class="strip-action">
                <a 
                  href={`${whatsappBase}${encodeURIComponent(plan.whatsappMsg)}`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class={`strip-btn ${plan.popular ? 'btn-emerald-cta' : 'btn-ghost-cta'}`}
                >
                  <span>{plan.ctaText}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          ))}

          {/* CLONED SET FOR SEAMLESS 100% INFINITE MOBILE HARDWARE-ACCELERATED FLOW */}
          {advisoryPlans.map((plan) => (
            <div 
              class={`strip-card ${plan.popular ? 'card-featured' : ''} card-clone`}
              data-plan-id={plan.id}
              aria-hidden="true"
            >
              {plan.popular && (
                <div class="card-ribbon">
                  <span>{plan.badge}</span>
                </div>
              )}
              
              <div class="strip-card-top">
                <span class="plan-cat-badge">{plan.category}</span>
                <h3 class="plan-card-title">{plan.title}</h3>
                <p class="plan-card-desc">{plan.description}</p>
              </div>

              <div class="strip-price-block">
                <div class="price-line">
                  <span 
                    class="price-number" 
                    data-price-weekly={plan.pricing.weekly.fee}
                    data-price-monthly={plan.pricing.monthly.fee}
                    data-price-quarterly={plan.pricing.quarterly.fee}
                  >
                    {plan.pricing.quarterly.fee}
                  </span>
                  <span 
                    class="price-period"
                    data-period-weekly={plan.pricing.weekly.cycle}
                    data-period-monthly={plan.pricing.monthly.cycle}
                    data-period-quarterly={plan.pricing.quarterly.cycle}
                  >
                    {plan.pricing.quarterly.cycle}
                  </span>
                </div>
                <span 
                  class="price-note"
                  data-note-weekly={plan.pricing.weekly.note}
                  data-note-monthly={plan.pricing.monthly.note}
                  data-note-quarterly={plan.pricing.quarterly.note}
                >
                  {plan.pricing.quarterly.note}
                </span>
              </div>

              <div class="specs-mini-table">
                {plan.specs.map((sp) => (
                  <div class="spec-row">
                    <span class="spec-k">{sp.label}</span>
                    <span class="spec-v">{sp.value}</span>
                  </div>
                ))}
              </div>

              <ul class="strip-features">
                {plan.features.map((feat) => (
                  <li>
                    <svg class="check-bullet" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <div class="strip-action">
                <a 
                  href={`${whatsappBase}${encodeURIComponent(plan.whatsappMsg)}`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class={`strip-btn ${plan.popular ? 'btn-emerald-cta' : 'btn-ghost-cta'}`}
                >
                  <span>{plan.ctaText}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- PANEL 2: COURSES & TRADING ACADEMY (SLIM DISTRESSED STROKE & CONTINUOUS CONNECTED TRACK) -->
    <div 
      id="panel-courses" 
      class="tab-panel hidden-panel" 
      role="tabpanel" 
      aria-labelledby="tab-btn-courses"
    >
      <div class="continuous-track-wrapper reveal-on-scroll">
        <!-- Header with Slim Distressed Brush Underline, 2-Color Phase Split, and Slim Stroked Price -->
        <div class="track-hero-head">
          <div class="track-title-wrap">
            <h3 class="track-main-title">Master Trader 3-Month Learning Track</h3>
            
            <!-- Slim, Lighter Distressed Brush Underline (Gradient Colored, Dry-Brush Bristles & Fissures) -->
            <svg class="distressed-brush-svg title-brush-distressed" viewBox="0 0 500 14" fill="none" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="distressed-title-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#047857"/>
                  <stop offset="25%" stop-color="#10B981"/>
                  <stop offset="55%" stop-color="#F59E0B"/>
                  <stop offset="85%" stop-color="#D97706"/>
                  <stop offset="100%" stop-color="#92400E"/>
                </linearGradient>
              </defs>
              <!-- Slim, elegant distressed brush swipe -->
              <path 
                d="M 10 7 C 25 5, 45 6, 75 5 C 120 4, 175 6, 235 5 C 295 4, 355 6, 415 5 C 455 6, 480 4, 492 6 C 496 7, 495 8, 488 9 C 465 10, 420 8, 365 9 C 300 10, 240 8, 175 10 C 115 11, 65 9, 28 10 C 14 10, 8 8, 10 7 Z" 
                fill="url(#distressed-title-grad)"
              />
              <path 
                d="M 18 4 C 80 2, 160 3, 245 2 C 330 3, 410 2, 485 4" 
                stroke="url(#distressed-title-grad)" 
                stroke-width="1.5" 
                stroke-linecap="round" 
                stroke-dasharray="28 6 14 5 36 8 20 6" 
                opacity="0.85"
              />
              <path 
                d="M 14 11 C 70 12, 150 13, 235 12 C 320 11, 400 12, 488 10" 
                stroke="url(#distressed-title-grad)" 
                stroke-width="1.2" 
                stroke-linecap="round" 
                stroke-dasharray="22 8 32 6 15 5 26 7" 
                opacity="0.75"
              />
            </svg>
          </div>

          <!-- Two Distinct Colors for the 2 Phases -->
          <div class="track-phases-split">
            <span class="track-phase-tag phase-emerald">
              <span class="phase-pip pip-emerald"></span>
              1 Month Live Masterclasses
            </span>
            <span class="track-phase-divider" aria-hidden="true">&bull;</span>
            <span class="track-phase-tag phase-amber">
              <span class="phase-pip pip-amber"></span>
              2 Months Live Market Practice &amp; Personal Doubt Clearing
            </span>
          </div>

          <!-- All-Inclusive Program Fee with Slim Distressed Brush Stroke -->
          <div class="track-price-stage">
            <div class="track-price-badge">
              <span class="price-eyebrow">All-Inclusive Cohort Fee</span>
              <div class="price-val-row">
                <span class="price-currency">₹</span>
                <span class="price-amount">14,999</span>
                <span class="price-term">one-time investment</span>
              </div>
              
              <!-- Slim Distressed Brush Accent Under Price -->
              <svg class="distressed-brush-svg price-brush-distressed" viewBox="0 0 240 12" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="distressed-price-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#047857"/>
                    <stop offset="30%" stop-color="#10B981"/>
                    <stop offset="65%" stop-color="#F59E0B"/>
                    <stop offset="100%" stop-color="#D97706"/>
                  </linearGradient>
                </defs>
                <path 
                  d="M 6 6 C 20 5, 40 6, 70 5 C 110 4, 150 6, 190 5 C 215 5, 230 4, 236 6 C 238 7, 235 8, 228 8 C 210 9, 180 8, 145 9 C 105 10, 65 8, 30 9 C 14 9, 6 8, 6 6 Z" 
                  fill="url(#distressed-price-grad)"
                />
                <path 
                  d="M 12 3 C 50 2, 100 2, 155 3 C 195 3, 222 4, 232 5" 
                  stroke="url(#distressed-price-grad)" 
                  stroke-width="1.3" 
                  stroke-linecap="round" 
                  stroke-dasharray="20 5 12 4 28 6" 
                  opacity="0.85"
                />
                <path 
                  d="M 10 9 C 60 10, 110 10, 165 9 C 195 9, 218 9, 228 8" 
                  stroke="url(#distressed-price-grad)" 
                  stroke-width="1.1" 
                  stroke-linecap="round" 
                  stroke-dasharray="16 6 24 5" 
                  opacity="0.75"
                />
              </svg>
            </div>
          </div>
        </div>

        <!-- REFINED SERPENTINE TRACK WITH CLEAN OUTER LOOPS & SLEEK INLINE CHEVRONS -->
        <div class="serpentine-track-stage" id="serpentine-stage">
          <!-- ROW 1: Modules 01 -> 04 (Left to Right) -->
          <div class="track-row track-row-1">
            <div class="track-rail-stage">
              <!-- Dashed Rail Line with Sleek Inline Chevrons -->
              <div class="rail-dashed-track rail-track-emerald" aria-hidden="true">
                <span class="rail-inline-chevron chevron-pos-1" title="Flow to Module 02">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 1 1 L 5 5 L 1 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 7 1 L 11 5 L 7 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 13 1 L 17 5 L 13 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="rail-inline-chevron chevron-pos-2" title="Flow to Module 03">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 1 1 L 5 5 L 1 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 7 1 L 11 5 L 7 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 13 1 L 17 5 L 13 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="rail-inline-chevron chevron-pos-3" title="Flow to Module 04">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 1 1 L 5 5 L 1 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 7 1 L 11 5 L 7 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 13 1 L 17 5 L 13 9" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>

              <!-- TRACK LOOP 1: DIRECT CONTINUOUS U-TURN FROM RIGHT OF 04 BENDING OUTSIDE INTO RIGHT OF 05 -->
              <div class="track-bend-loop loop-right" aria-hidden="true">
                <svg class="loop-svg" viewBox="0 0 100 100" fill="none" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="loop-grad-4-to-5" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#059669"/>
                      <stop offset="60%" stop-color="#10B981"/>
                      <stop offset="100%" stop-color="#D97706"/>
                    </linearGradient>
                    <marker id="arrow-into-5" viewBox="0 0 10 10" refX="2" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                      <polygon points="9,1 2,5 9,9" fill="#D97706" />
                    </marker>
                  </defs>
                  <path 
                    d="M 0 0 C 85 0, 100 20, 100 50 C 100 80, 85 100, 2 100" 
                    stroke="url(#loop-grad-4-to-5)" 
                    stroke-width="3" 
                    stroke-dasharray="6 4" 
                    stroke-linecap="round"
                    vector-effect="non-scaling-stroke"
                    marker-end="url(#arrow-into-5)"
                  />
                </svg>
              </div>
              
              <!-- 4 Waypoint Stations -->
              <div class="stations-grid">
                {row1Stations.map((m) => (
                  <div class="track-station" data-mod-num={m.num}>
                    <div class="station-node-dot dot-emerald">
                      <span>{m.num}</span>
                    </div>
                    <div class="station-content">
                      <span class="station-chip chip-emerald">{m.tag}</span>
                      <h4 class="station-title">{m.title}</h4>
                      <p class="station-desc">{m.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- ROW 2: Modules 08 <- 07 <- 06 <- 05 (Right to Left) -->
          <div class="track-row track-row-2">
            <div class="track-rail-stage">
              <!-- Dashed Horizontal Rail Line with Sleek Inline Chevrons (Pointing Left) -->
              <div class="rail-dashed-track rail-track-amber" aria-hidden="true">
                <span class="rail-inline-chevron chevron-pos-3" title="Flow to Module 06">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 17 1 L 13 5 L 17 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 11 1 L 7 5 L 11 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 5 1 L 1 5 L 5 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="rail-inline-chevron chevron-pos-2" title="Flow to Module 07">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 17 1 L 13 5 L 17 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 11 1 L 7 5 L 11 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 5 1 L 1 5 L 5 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="rail-inline-chevron chevron-pos-1" title="Flow to Module 08">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 17 1 L 13 5 L 17 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 11 1 L 7 5 L 11 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 5 1 L 1 5 L 5 9" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>

              <!-- TRACK LOOP 2: DIRECT CONTINUOUS U-TURN FROM LEFT OF 08 BENDING OUTSIDE INTO LEFT OF 09 -->
              <div class="track-bend-loop loop-left" aria-hidden="true">
                <svg class="loop-svg" viewBox="0 0 100 100" fill="none" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="loop-grad-8-to-9" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#D97706"/>
                      <stop offset="60%" stop-color="#F59E0B"/>
                      <stop offset="100%" stop-color="#B45309"/>
                    </linearGradient>
                    <marker id="arrow-into-9" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                      <polygon points="1,1 8,5 1,9" fill="#B45309" />
                    </marker>
                  </defs>
                  <path 
                    d="M 100 0 C 15 0, 0 20, 0 50 C 0 80, 15 100, 98 100" 
                    stroke="url(#loop-grad-8-to-9)" 
                    stroke-width="3" 
                    stroke-dasharray="6 4" 
                    stroke-linecap="round"
                    vector-effect="non-scaling-stroke"
                    marker-end="url(#arrow-into-9)"
                  />
                </svg>
              </div>
              
              <!-- 4 Waypoint Stations in Left-to-Right DOM (8, 7, 6, 5) representing Right-to-Left Trajectory -->
              <div class="stations-grid">
                {row2StationsReversed.map((m) => (
                  <div class="track-station" data-mod-num={m.num}>
                    <div class="station-node-dot dot-amber">
                      <span>{m.num}</span>
                    </div>
                    <div class="station-content">
                      <span class="station-chip chip-amber">{m.tag}</span>
                      <h4 class="station-title">{m.title}</h4>
                      <p class="station-desc">{m.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- ROW 3: Modules 09 -> 11 + Finish Milestone (Left to Right) -->
          <div class="track-row track-row-3">
            <div class="track-rail-stage">
              <!-- Dashed Horizontal Rail Line with Sleek Inline Chevrons -->
              <div class="rail-dashed-track rail-track-gold" aria-hidden="true">
                <span class="rail-inline-chevron chevron-pos-1" title="Flow to Module 10">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 1 1 L 5 5 L 1 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 7 1 L 11 5 L 7 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 13 1 L 17 5 L 13 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="rail-inline-chevron chevron-pos-2" title="Flow to Module 11">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 1 1 L 5 5 L 1 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 7 1 L 11 5 L 7 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 13 1 L 17 5 L 13 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="rail-inline-chevron chevron-pos-3" title="Flow to Milestone Finish">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M 1 1 L 5 5 L 1 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 7 1 L 11 5 L 7 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M 13 1 L 17 5 L 13 9" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
              
