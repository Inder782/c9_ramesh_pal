---
import config from '../data/config.json';
import LegalModals from './LegalModals.astro';
import '../styles/components/footer.css';
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-container">
    
    <!-- Main Lean Footer Grid -->
    <div class="footer-grid">
      <!-- Col 1: Identity & Glowing Socials -->
      <div class="footer-col">
        <a href="#home" class="footer-brand" aria-label={`${config.brandName} Home`}>
          <img src="/images/logo-light.png" alt={`${config.brandName} Logo`} width="180" height="40" class="footer-logo-img" />
        </a>
        <p class="footer-about-text">
          Institutional-grade equity research governed by the discipline of an accredited educator. Systematic pattern repetition and mathematical risk control.
        </p>
        <div class="analyst-sebi-meta">
          <p><strong>SEBI Reg. No:</strong> {config.sebiRegNo}</p>
          <p><strong>BSE Enlistment:</strong> {config.bseEnlistmentNo}</p>
          <p><strong>Registration Type:</strong> Individual Research Analyst</p>
        </div>

        <!-- Glowing Social Icons -->
        <div class="footer-socials">
          <span class="socials-label">Official Socials:</span>
          <div class="social-icons-row">
            <!-- Telegram -->
            <a href={config.socials.telegram} target="_blank" rel="noopener noreferrer" class="glow-icon-btn glow-telegram" aria-label="Official Telegram Channel" title="Telegram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.63 3.73-.53.36-1.02.54-1.45.53-.48-.01-1.4-.27-2.09-.49-.84-.27-1.51-.42-1.45-.88.03-.24.37-.49 1.02-.75 3.99-1.74 6.66-2.88 8.01-3.44 3.81-1.59 4.6-1.87 5.12-1.88.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.16-.04.32z"/>
              </svg>
            </a>

            <!-- YouTube -->
            <a href={config.socials.youtube} target="_blank" rel="noopener noreferrer" class="glow-icon-btn glow-youtube" aria-label="Official YouTube Channel" title="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- X (Twitter) -->
            <a href={config.socials.twitter} target="_blank" rel="noopener noreferrer" class="glow-icon-btn glow-x" aria-label="Official X (Twitter) Profile" title="X (Twitter)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>

            <!-- Instagram -->
            <a href={config.socials.instagram} target="_blank" rel="noopener noreferrer" class="glow-icon-btn glow-instagram" aria-label="Official Instagram Profile" title="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a href={config.socials.linkedin} target="_blank" rel="noopener noreferrer" class="glow-icon-btn glow-linkedin" aria-label="Official LinkedIn Profile" title="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="footer-col">
        <h4 class="footer-col-title">Navigation</h4>
        <ul class="footer-links-list">
          <li><a href="#home" class="footer-link">Home</a></li>
          <li><a href="#about" class="footer-link">About Analyst</a></li>
          <li><a href="#offerings" class="footer-link">Advisory Offerings</a></li>
          <li><a href="#investor-charter" class="footer-link">Investor Charter</a></li>
          <li><a href="#compliance" class="footer-link">Grievance Redressal</a></li>
          <li><a href="#regulatory" class="footer-link">Investor Complaints</a></li>
        </ul>
      </div>

      <!-- Col 3: Statutory Modals -->
      <div class="footer-col">
        <h4 class="footer-col-title">Statutory Documents</h4>
        <ul class="footer-links-list">
          <li>
            <button type="button" class="modal-link-btn" data-open-dialog="dialog-disclosures">
              SEBI Statutory Disclosures
            </button>
          </li>
          <li>
            <button type="button" class="modal-link-btn" data-open-dialog="dialog-terms">
              Terms &amp; Conditions
            </button>
          </li>
          <li>
            <button type="button" class="modal-link-btn" data-open-dialog="dialog-privacy">
              Privacy Policy
            </button>
          </li>
          <li>
            <button type="button" class="modal-link-btn" data-open-dialog="dialog-refund">
              Refund &amp; Cancellation
            </button>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contact & Regulatory Portals -->
      <div class="footer-col">
        <h4 class="footer-col-title">Contact &amp; Portals</h4>
        <div class="contact-card-footer">
          <p><strong>Email:</strong> <a href={`mailto:${config.email}`} class="footer-link">{config.email}</a></p>
          <p><strong>Phone:</strong> {config.phone}</p>
          <p><strong>Registered Office:</strong> {config.registeredAddress}</p>
          <div class="ext-portals">
            <a href={config.compliance.scoresUrl} target="_blank" rel="noopener noreferrer" class="portal-link">
              <span>SEBI SCORES 2.0</span>
              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
            <a href={config.compliance.smartOdrUrl} target="_blank" rel="noopener noreferrer" class="portal-link">
              <span>SMART ODR Portal</span>
              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar with Yellow Heart Credit -->
    <div class="footer-bottom">
      <p class="copyright-text">
        &copy; {new Date().getFullYear()} {config.brandName}. All rights reserved.
      </p>
      
      <p class="developer-credit">
        Developed with <span class="heart-emoji" role="img" aria-label="yellow love">💛</span> by 
        <a href="https://lightspeeddevs.com/" target="_blank" rel="noopener noreferrer" class="lightspeed-link">
          LightSpeedDev
        </a>
      </p>
    </div>

  </div>

  <!-- Include Native Legal Modals in DOM -->
  <LegalModals />
</footer>
