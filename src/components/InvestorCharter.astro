---
import config from '../data/config.json';
---

<section class="charter-section" id="investor-charter" aria-labelledby="charter-heading">
  <div class="container">
    <div class="section-head reveal-on-scroll">
      <div class="badge-pill">SEBI Statutory Framework</div>
      <h2 id="charter-heading" class="section-title">
        Investor Charter for Research Analysts
      </h2>
      <p class="section-lead">
        In accordance with SEBI circulars, this charter outlines the vision, mission, advisory standards, rights, and responsibilities for all investors dealing with SEBI Registered Research Analysts.
      </p>
    </div>

    <!-- Vision & Mission Banner -->
    <div class="vision-mission-grid reveal-on-scroll">
      <div class="vm-card">
        <div class="vm-icon" aria-hidden="true">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </div>
        <h3 class="vm-title">Vision</h3>
        <p class="vm-text">
          To protect the interests of investors in securities and to promote the development of, and to regulate, the securities market by providing objective, unbiased, and research-backed analysis.
        </p>
      </div>

      <div class="vm-card">
        <div class="vm-icon" aria-hidden="true">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="vm-title">Mission</h3>
        <p class="vm-text">
          To provide independent, well-researched, unbiased opinions on securities to clients without any conflict of interest, ensuring integrity, transparency, and strict adherence to regulatory standards.
        </p>
      </div>
    </div>

    <!-- Rights & Responsibilities -->
    <div class="charter-details-grid reveal-on-scroll">
      <!-- Rights Card -->
      <div class="charter-block">
        <h3 class="block-title">Rights of Investors</h3>
        <ul class="charter-list">
          <li><strong>Right to Impartial Research:</strong> To receive unbiased, independent research reports based on verifiable data.</li>
          <li><strong>Right to Full Transparency:</strong> To be informed of all actual or potential conflicts of interest, holdings, or commercial affiliations.</li>
          <li><strong>Right to Grievance Redressal:</strong> To have all valid queries and grievances addressed within 21 working days.</li>
          <li><strong>Right to Escalation:</strong> To escalate unresolved disputes through SEBI SCORES 2.0 or the SMART ODR portal.</li>
        </ul>
      </div>

      <!-- Do's and Don'ts Card -->
      <div class="charter-block">
        <h3 class="block-title">Investor Guidance (Do's &amp; Don'ts)</h3>
        <div class="guidance-columns">
          <div class="dos-box">
            <h4 class="dos-title">
              <span class="icon-indicator" aria-hidden="true">✓</span> DO's:
            </h4>
            <ul>
              <li>Verify SEBI registration details on the official SEBI portal before subscribing.</li>
              <li>Pay subscription fees strictly through official banking channels with valid GST invoices.</li>
              <li>Read all risk disclosures and understand that equity investments carry risk of loss.</li>
            </ul>
          </div>

          <div class="donts-box">
            <h4 class="donts-title">
              <span class="icon-indicator" aria-hidden="true">&times;</span> DON'Ts:
            </h4>
            <ul>
              <li>Do NOT believe promises of guaranteed, fixed, or risk-free market returns.</li>
              <li>Do NOT share your Demat/Trading account login credentials with any analyst.</li>
              <li>Do NOT transfer funds into personal bank accounts not designated for subscription.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .charter-section {
    padding: 100px 0;
    background-color: var(--bg-primary);
    contain: content;
  }

  .section-head {
    max-width: 760px;
    margin: 0 auto 64px auto;
    text-align: center;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin: 16px 0 20px 0;
    letter-spacing: -0.02em;
  }

  .section-lead {
    font-size: 1.125rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  .vision-mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-bottom: 48px;
  }

  .vm-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 32px 28px;
    box-shadow: var(--shadow-sm);
  }

  .vm-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .vm-title {
    font-size: 1.375rem;
    margin: 0 0 10px 0;
  }

  .vm-text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .charter-details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .charter-block {
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 32px 28px;
    box-shadow: var(--shadow-sm);
  }

  .block-title {
    font-size: 1.375rem;
    margin: 0 0 20px 0;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 12px;
  }

  .charter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .charter-list li {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
    position: relative;
    padding-left: 18px;
  }

  .charter-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent-primary);
    font-weight: bold;
    font-size: 1.1rem;
  }

  .guidance-columns {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .dos-box, .donts-box {
    padding: 16px;
    border-radius: 10px;
  }

  .dos-box {
    background: rgba(6, 95, 70, 0.04);
    border: 1px solid var(--accent-border);
  }

  .donts-box {
    background: rgba(220, 38, 38, 0.04);
    border: 1px solid #FECACA;
  }

  .dos-title {
    font-size: 0.9375rem;
    color: var(--accent-primary);
    margin: 0 0 10px 0;
    font-weight: 700;
  }

  .donts-title {
    font-size: 0.9375rem;
    color: #DC2626;
    margin: 0 0 10px 0;
    font-weight: 700;
  }

  .dos-box ul, .donts-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dos-box li, .donts-box li {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  @media (max-width: 840px) {
    .vision-mission-grid, .charter-details-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
