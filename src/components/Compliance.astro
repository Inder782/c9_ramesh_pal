---
import config from '../data/config.json';
---

<section class="compliance-section" id="compliance" aria-labelledby="compliance-heading">
  <div class="container">
    <div class="section-head reveal-on-scroll">
      <div class="badge-pill">Redressal Mechanism</div>
      <h2 id="compliance-heading" class="section-title">
        Grievance Redressal &amp; Dispute Resolution
      </h2>
      <p class="section-lead">
        In strict compliance with SEBI (Research Analysts) Regulations, 2014, we adhere to a transparent, 3-tier time-bound grievance escalation process.
      </p>
    </div>

    <!-- 3-Tier Grievance Escalation Timeline -->
    <div class="escalation-timeline reveal-on-scroll">
      <h3 class="timeline-title">3-Tier Escalation Timeline</h3>
      
      <div class="timeline-grid">
        <!-- Level 1: Internal -->
        <div class="tier-card">
          <div class="tier-head">
            <span class="level-tag">LEVEL 01</span>
            <span class="tat-pill">TAT: 21 WORKING DAYS</span>
          </div>
          <h4 class="tier-name">Internal Compliance Desk</h4>
          <p class="tier-desc">
            Directly email our dedicated compliance officer with your subscription details and query.
          </p>
          <div class="tier-details">
            <p><strong>Compliance Officer:</strong> {config.compliance.officerName}</p>
            <p><strong>Email:</strong> <a href={`mailto:${config.compliance.officerEmail}`} class="content-link">{config.compliance.officerEmail}</a></p>
            <p><strong>Phone:</strong> {config.compliance.officerPhone}</p>
            <p><strong>Address:</strong> {config.registeredAddress}</p>
          </div>
        </div>

        <!-- Level 2: SEBI SCORES -->
        <div class="tier-card">
          <div class="tier-head">
            <span class="level-tag">LEVEL 02</span>
            <span class="tat-pill regulatory-pill">SEBI REGULATORY</span>
          </div>
          <h4 class="tier-name">SEBI SCORES 2.0 Portal</h4>
          <p class="tier-desc">
            If your grievance remains unaddressed past 21 working days or you are unsatisfied with the resolution.
          </p>
          <div class="tier-details">
            <p><strong>Portal:</strong> <a href={config.compliance.scoresUrl} target="_blank" rel="noopener noreferrer" class="content-link">scores.sebi.gov.in</a></p>
            <p><strong>SEBI Toll-Free:</strong> 1800 22 7575 / 1800 266 7575</p>
            <p><strong>Mobile App:</strong> SEBI SCORES App (iOS &amp; Android)</p>
            <p><strong>SEBI Bhavan:</strong> BKC, Bandra (E), Mumbai - 400 051</p>
          </div>
        </div>

        <!-- Level 3: SMART ODR -->
        <div class="tier-card">
          <div class="tier-head">
            <span class="level-tag">LEVEL 03</span>
            <span class="tat-pill odr-pill">ONLINE DISPUTE</span>
          </div>
          <h4 class="tier-name">SMART ODR Portal</h4>
          <p class="tier-desc">
            For online conciliation and independent legal arbitration facilitated by SEBI's institutional framework.
          </p>
          <div class="tier-details">
            <p><strong>Portal:</strong> <a href={config.compliance.smartOdrUrl} target="_blank" rel="noopener noreferrer" class="content-link">smartodr.in</a></p>
            <p><strong>Facilitated By:</strong> SEBI Recognized Institutions</p>
            <p><strong>Scope:</strong> Independent dispute conciliation</p>
            <p><strong>Mechanism:</strong> Hybrid digital arbitration</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Grievance Classification -->
    <div class="classification-grid reveal-on-scroll">
      <div class="class-card valid-card">
        <h4 class="class-title">
          <span class="icon-indicator" aria-hidden="true">✓</span>
          Grievances Handled by This Desk:
        </h4>
        <ul class="class-list">
          <li>Delays or issues in receiving designated research notes or delivery channels.</li>
          <li>Discrepancies in subscription billing or official GST invoices.</li>
          <li>Non-receipt of periodic follow-ups or trade invalidation alerts.</li>
          <li>Clarifications regarding SEBI compliance disclosures and research reports.</li>
        </ul>
      </div>

      <div class="class-card invalid-card">
        <h4 class="class-title">
          <span class="icon-indicator" aria-hidden="true">&times;</span>
          What Does NOT Constitute a Grievance:
        </h4>
        <ul class="class-list">
          <li>Normal market mark-to-market fluctuations or individual idea stop-losses.</li>
          <li>Demands for guaranteed profits, portfolio management, or trade execution.</li>
          <li>Issues arising from individual broker terminals or third-party execution delays.</li>
          <li>Refusal to accept the inherent risks of securities trading.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .compliance-section {
    padding: 100px 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .section-head {
    max-width: 760px;
    margin: 0 auto 64px auto;
    text-align: center;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin: 16px 0 20px 0;
    letter-spacing: -0.02em;
  }

  .section-lead {
    font-size: 1.125rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  .escalation-timeline {
    margin-bottom: 56px;
  }

  .timeline-title {
    font-size: 1.375rem;
    text-align: center;
    margin-bottom: 32px;
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .tier-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 28px 24px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .tier-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .level-tag {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-primary);
    background: var(--bg-secondary);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--border-light);
  }

  .tat-pill {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent-primary);
    background: var(--accent-soft);
    padding: 3px 8px;
    border-radius: 9999px;
  }

  .regulatory-pill {
    color: #1E40AF;
    background: #EFF6FF;
  }

  .odr-pill {
    color: #92400E;
    background: #FEF3C7;
  }

  .tier-name {
    font-size: 1.1875rem;
    margin: 0 0 10px 0;
  }

  .tier-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 20px;
  }

  .tier-details {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border-light);
    font-size: 0.8125rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tier-details p {
    margin: 0;
    line-height: 1.45;
  }

  /* Classification */
  .classification-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .class-card {
    border-radius: 16px;
    padding: 28px;
    border: 1px solid var(--border-light);
  }

  .valid-card {
    background: rgba(6, 95, 70, 0.03);
    border-color: var(--accent-border);
  }

  .invalid-card {
    background: rgba(220, 38, 38, 0.03);
    border-color: #FECACA;
  }

  .class-title {
    font-size: 1.0625rem;
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .valid-card .class-title {
    color: var(--accent-primary);
  }

  .invalid-card .class-title {
    color: #DC2626;
  }

  .class-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .class-list li {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
    position: relative;
    padding-left: 18px;
  }

  .class-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    font-weight: bold;
  }

  @media (max-width: 900px) {
    .timeline-grid, .classification-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
