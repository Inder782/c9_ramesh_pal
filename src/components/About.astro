---
import config from '../data/config.json';
---

<section class="about-section" id="about" aria-labelledby="about-heading">
  <div class="container">
    <div class="about-grid">
      <!-- Left Column: Concise Narrative & Credentials -->
      <div class="about-content reveal-on-scroll">
        <span class="sub-label">About the Analyst</span>
        <h2 id="about-heading" class="analyst-name">{config.analystName}</h2>
        <p class="analyst-tagline">
          SEBI Registered Research Analyst &bull; Founder, Dehradun Bulls
        </p>

        <div class="bio-paragraphs">
          <p>
            Based in Dehradun, Uttarakhand, Ramesh Pal brings an academic discipline to the Indian stock market. Holding an <strong>M.A. in Economics (University Topper)</strong> and an <strong>MBA in Finance</strong>, he approaches market movements not through speculative tips or emotional impulse, but through structural economics, volume profile, and systematic risk management.
          </p>
          <p>
            Over 7+ years of active market trading, his philosophy has remained steadfast: true market competence is built on repeating proven high-probability patterns, respecting a strict <strong>1–2% capital risk rule</strong>, and maintaining uncompromising emotional composure.
          </p>
        </div>

        <!-- Clean Micro Credential Badges -->
        <div class="credentials-pills">
          <span class="cred-pill cred-pill-accent">
            <span class="pill-dot"></span>
            SEBI Reg: <strong>{config.sebiRegNo}</strong>
          </span>
          <span class="cred-pill">BSE Enlistment: <strong>{config.bseEnlistmentNo}</strong></span>
          <span class="cred-pill">M.A. Economics (Univ. Topper)</span>
          <span class="cred-pill">MBA in Finance</span>
          <span class="cred-pill">7+ Years Active Trading</span>
          <span class="cred-pill">Dehradun, Uttarakhand</span>
        </div>
      </div>

      <!-- Right Column: Borderless Image with Radiant Mixing Ambient Orbs Behind -->
      <div class="about-media reveal-on-scroll">
        <div class="image-stage">
          <!-- Fluid Mixing Glow Orbs Directly Behind Image -->
          <div class="orbs-container" aria-hidden="true">
            <div class="glow-orb orb-emerald"></div>
            <div class="glow-orb orb-amber"></div>
            <div class="glow-orb orb-tangerine"></div>
            <div class="glow-orb orb-teal"></div>
            <div class="glow-orb orb-gold-mist"></div>
          </div>

          <!-- Clean Borderless Photo Card -->
          <div class="photo-card">
            <!-- Subtle Studio Depth Lighting -->
            <div class="studio-light" aria-hidden="true"></div>

            <!-- Crisp Portrait (100% Borderless) -->
            <img 
              src="/images/ramesh-pal.jpg" 
              alt="Ramesh Pal - SEBI Registered Research Analyst and Founder of Dehradun Bulls" 
              class="mentor-img"
              width="972"
              height="1200"
              loading="lazy"
              decoding="async"
            />

            <!-- Subtle Base Vignette -->
            <div class="photo-vignette" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 60px 0 72px 0;
    background-color: var(--bg-primary);
    position: relative;
    overflow: hidden;
    contain: content;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }

  /* Left Column */
  .sub-label {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-primary);
    margin-bottom: 8px;
  }

  .analyst-name {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    margin: 0 0 8px 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .analyst-tagline {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--accent-bronze);
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .bio-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }

  .bio-paragraphs p {
    font-size: 1.03125rem;
    line-height: 1.68;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Credentials Pills */
  .credentials-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cred-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    padding: 6px 14px;
    border-radius: 9999px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .cred-pill-accent {
    background: var(--accent-soft);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
  }

  /* ========================================================
     BORDERLESS IMAGE STAGE WITH FLUID MIXING ORBS BEHIND
     ======================================================== */
  .about-media {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .image-stage {
    position: relative;
    max-width: 420px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Orbs Container Layer Directly Behind Photo (Natural Unclipped Atmosphere) */
  .orbs-container {
    position: absolute;
    inset: -80px;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(52px);
    opacity: 0.55;
    will-change: transform;
    pointer-events: none;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* Orb 1: Vibrant Emerald / Mint (Top-Left) */
  .orb-emerald {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.65) 0%, rgba(5, 150, 105, 0.3) 45%, rgba(6, 78, 59, 0.1) 70%, transparent 100%);
    top: -40px;
    left: -50px;
    animation: driftOrb1 10s ease-in-out infinite alternate;
  }

  /* Orb 2: Warm Golden Amber (Top-Right) */
  .orb-amber {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.65) 0%, rgba(217, 119, 6, 0.3) 45%, rgba(180, 83, 9, 0.08) 70%, transparent 100%);
    top: -30px;
    right: -40px;
    animation: driftOrb2 11s ease-in-out infinite alternate-reverse;
  }

  /* Orb 3: Luminous Tangerine Glow (Mid-Right Edge) */
  .orb-tangerine {
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(251, 146, 60, 0.6) 0%, rgba(234, 88, 12, 0.25) 45%, transparent 75%);
    top: 38%;
    right: -50px;
    animation: driftOrb3 12s ease-in-out infinite alternate;
  }

  /* Orb 4: Deep Mountain Teal & Pine (Bottom-Left) */
  .orb-teal {
    width: 290px;
    height: 290px;
    background: radial-gradient(circle, rgba(13, 148, 136, 0.6) 0%, rgba(6, 78, 59, 0.28) 45%, transparent 75%);
    bottom: -40px;
    left: -40px;
    animation: driftOrb2 10.5s ease-in-out infinite alternate;
  }

  /* Orb 5: Warm Center-Bottom Golden Radiance */
  .orb-gold-mist {
    width: 280px;
    height: 240px;
    background: radial-gradient(ellipse, rgba(252, 211, 77, 0.5) 0%, rgba(245, 158, 11, 0.2) 50%, transparent 75%);
    bottom: -25px;
    left: 20%;
    opacity: 0.45;
    animation: driftOrb1 9.5s ease-in-out infinite alternate-reverse;
  }

  /* Fluid Hardware-Accelerated 3D Drifting Animations (0% CPU Paint Cost) */
  @keyframes driftOrb1 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    100% {
      transform: translate3d(22px, 16px, 0) scale(1.12);
    }
  }

  @keyframes driftOrb2 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    100% {
      transform: translate3d(-18px, -14px, 0) scale(1.1);
    }
  }

  @keyframes driftOrb3 {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    100% {
      transform: translate3d(-12px, 20px, 0) scale(1.14);
    }
  }

  /* Hover Intensification */
  .image-stage:hover .glow-orb {
    opacity: 0.75;
  }

  .image-stage:hover .orb-emerald {
    transform: scale(1.15) translate3d(-12px, -8px, 0);
  }

  .image-stage:hover .orb-amber {
    transform: scale(1.15) translate3d(12px, -8px, 0);
  }

  .image-stage:hover .orb-tangerine {
    transform: scale(1.18) translate3d(14px, 10px, 0);
  }

  /* Clean Borderless Photo Card */
  .photo-card {
    position: relative;
    width: 100%;
    border-radius: 22px;
    overflow: hidden;
    background: #0E161B;
    border: none;
    outline: none;
    box-shadow: 0 20px 48px rgba(14, 22, 27, 0.18);
    z-index: 2;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .image-stage:hover .photo-card {
    transform: translateY(-5px) scale(1.015);
    box-shadow: 0 28px 64px rgba(14, 22, 27, 0.24);
  }

  /* Subtle Studio Lighting Behind Subject */
  .studio-light {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 60%;
    background: radial-gradient(ellipse at 50% 30%, rgba(16, 185, 129, 0.25) 0%, rgba(245, 158, 11, 0.12) 45%, transparent 75%);
    z-index: 1;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .image-stage:hover .studio-light {
    opacity: 1;
  }

  /* Crisp Borderless Portrait */
  .mentor-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 4.9;
    object-fit: cover;
    object-position: center top;
    display: block;
    position: relative;
    z-index: 2;
    border: none;
    outline: none;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-stage:hover .mentor-img {
    transform: scale(1.025);
  }

  /* Subtle Base Vignette */
  .photo-vignette {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 36%;
    background: linear-gradient(to top, rgba(14, 22, 27, 0.92) 0%, rgba(14, 22, 27, 0.4) 50%, transparent 100%);
    z-index: 3;
    pointer-events: none;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-media {
      order: 2;
    }

    .about-content {
      order: 1;
    }

    .image-stage {
      max-width: 360px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .about-section {
      padding: 40px 0 52px 0;
    }

    .analyst-name {
      font-size: 2rem;
    }

    .analyst-tagline {
      font-size: 0.95rem;
    }

    .credentials-pills {
      gap: 8px;
    }

    .cred-pill {
      font-size: 0.75rem;
      padding: 5px 12px;
    }
  }
</style>
