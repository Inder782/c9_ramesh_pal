---
import config from '../data/config.json';
---

<section class="about-section" id="about" aria-labelledby="about-heading">
  <div class="container">
    <div class="about-grid">
      <!-- Left Column: Concise Narrative & Credentials -->
      <div class="about-content reveal-on-scroll">
        <span class="sub-label">About the Analyst</span>
        <h2 id="about-heading" class="analyst-name">{config.analystName}</h2>
        <p class="analyst-tagline">
          SEBI Registered Research Analyst &bull; Founder, Dehradun Bulls
        </p>

        <div class="bio-paragraphs">
          <p>
            Based in Dehradun, Uttarakhand, Ramesh Pal brings an academic discipline to the Indian stock market. Holding an <strong>M.A. in Economics (University Topper)</strong> and an <strong>MBA in Finance</strong>, he approaches market movements not through speculative tips or emotional impulse, but through structural economics, volume profile, and systematic risk management.
          </p>
          <p>
            Over 7+ years of active market trading, his philosophy has remained steadfast: true market competence is built on repeating proven high-probability patterns, respecting a strict <strong>1–2% capital risk rule</strong>, and maintaining uncompromising emotional composure.
          </p>
        </div>

        <!-- Clean Micro Credential Badges -->
        <div class="credentials-pills">
          <span class="cred-pill cred-pill-accent">
            <span class="pill-dot"></span>
            SEBI Reg: <strong>{config.sebiRegNo}</strong>
          </span>
          <span class="cred-pill">BSE Enlistment: <strong>{config.bseEnlistmentNo}</strong></span>
          <span class="cred-pill">M.A. Economics (Univ. Topper)</span>
          <span class="cred-pill">MBA in Finance</span>
          <span class="cred-pill">7+ Years Active Trading</span>
          <span class="cred-pill">Dehradun, Uttarakhand</span>
        </div>
      </div>

      <!-- Right Column: Clean Image with Ambient Background Glow -->
      <div class="about-media reveal-on-scroll">
        <div class="image-glow-wrapper">
          <!-- Ambient Glow Halos Behind Image -->
          <div class="glow-orb glow-orb-emerald" aria-hidden="true"></div>
          <div class="glow-orb glow-orb-amber" aria-hidden="true"></div>

          <div class="photo-card">
            <img 
              src="/images/ramesh-pal.jpg" 
              alt="Ramesh Pal - SEBI Registered Research Analyst and Founder of Dehradun Bulls" 
              class="mentor-img"
              width="972"
              height="1200"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 56px 0 68px 0;
    background-color: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }

  /* Left Column */
  .sub-label {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-primary);
    margin-bottom: 8px;
  }

  .analyst-name {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    margin: 0 0 8px 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .analyst-tagline {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--accent-bronze);
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .bio-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }

  .bio-paragraphs p {
    font-size: 1.03125rem;
    line-height: 1.68;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Credentials Pills */
  .credentials-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cred-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    padding: 6px 14px;
    border-radius: 9999px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .cred-pill-accent {
    background: var(--accent-soft);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
  }

  /* Right Column: Clean Image with Ambient Glow */
  .about-media {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .image-glow-wrapper {
    position: relative;
    max-width: 420px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Multi-Tone Ambient Backlight Glow */
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(48px);
    pointer-events: none;
    z-index: 1;
    opacity: 0.45;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .glow-orb-emerald {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.5) 0%, rgba(6, 78, 59, 0.2) 70%, transparent 100%);
    top: -30px;
    left: -20px;
  }

  .glow-orb-amber {
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.45) 0%, rgba(146, 64, 14, 0.15) 70%, transparent 100%);
    bottom: -30px;
    right: -20px;
  }

  .image-glow-wrapper:hover .glow-orb-emerald {
    opacity: 0.65;
    transform: scale(1.08) translate(-8px, -8px);
  }

  .image-glow-wrapper:hover .glow-orb-amber {
    opacity: 0.65;
    transform: scale(1.08) translate(8px, 8px);
  }

  .photo-card {
    position: relative;
    width: 100%;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 16px 44px rgba(17, 24, 39, 0.08);
    background: #0E161B;
    z-index: 2;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .photo-card:hover {
    transform: translateY(-4px) scale(1.015);
    box-shadow: 0 24px 56px rgba(17, 24, 39, 0.14);
  }

  .mentor-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 4.9;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s ease;
  }

  .photo-card:hover .mentor-img {
    transform: scale(1.03);
  }

  /* Responsive */
  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-media {
      order: 2;
    }

    .about-content {
      order: 1;
    }

    .image-glow-wrapper {
      max-width: 360px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .about-section {
      padding: 40px 0 52px 0;
    }

    .analyst-name {
      font-size: 2rem;
    }

    .analyst-tagline {
      font-size: 0.95rem;
    }

    .credentials-pills {
      gap: 8px;
    }

    .cred-pill {
      font-size: 0.75rem;
      padding: 5px 12px;
    }
  }
</style>
