---
// Mentorship.astro - Classroom, Live Trading Desk & Academy Mentorship Showcase
import mentorshipItems from '../data/mentorship.json';
import '../styles/components/mentorship.css';

// Duplicate items for infinite seamless looping
const trackItems = [...mentorshipItems, ...mentorshipItems];
---

<section class="mentorship-section" id="mentorship" aria-labelledby="mentorship-heading">
  <div class="container mentorship-header-container reveal-on-scroll">
    <div class="mentorship-header-row">
      <div class="header-content">
        <span class="sub-label">ACADEMY &amp; FLOOR MENTORSHIP</span>
        <h2 id="mentorship-heading" class="section-title">
          Where Theory Meets Live Market Execution
        </h2>
        
        <!-- Highlighted Eyebrow Effect in One Line -->
        <div class="mentorship-eyebrow-line" role="note" aria-label="Mentorship Highlights">
          <span class="eyebrow-glow-dot" aria-hidden="true"></span>
          <span class="eyebrow-line-content">
            Offline Cohorts &amp; Workshops <span class="sep" aria-hidden="true">&bull;</span> Multi-Screen Trading Floor <span class="sep" aria-hidden="true">&bull;</span> Strict Capital Risk Discipline <span class="sep" aria-hidden="true">&bull;</span> Student Milestones
          </span>
        </div>

        <p class="section-description">
          Beyond theory and static books—hands-on offline classroom sessions, multi-screen live trading desk breakdowns, and real-time capital protection discipline.
        </p>
      </div>

      <!-- Accessible Pause/Play Floating Control (Visible & Non-Clipped) -->
      <div class="mentorship-control-wrap">
        <button 
          type="button" 
          class="reel-toggle-btn" 
          id="mentorship-toggle-btn" 
          aria-label="Pause Gallery" 
          aria-pressed="false"
          aria-controls="mentorship-reel-track"
          title="Pause / Resume gallery motion"
        >
          <span class="btn-icon-wrap" aria-hidden="true">
            <svg class="icon-pause" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <rect x="6" y="4" width="4" height="16" rx="1.5"></rect>
              <rect x="14" y="4" width="4" height="16" rx="1.5"></rect>
            </svg>
            <svg class="icon-play" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <path d="M7 4.5v15c0 .8.9 1.3 1.6.9l12-7.5c.7-.4.7-1.4 0-1.8l-12-7.5c-.7-.4-1.6.1-1.6.9z"></path>
            </svg>
          </span>
          <span class="toggle-text" id="mentorship-toggle-text">Pause Gallery</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Smooth Flowing Reel Stage -->
  <div class="reel-stage" id="mentorship-reel-stage" aria-label="Mentorship photo showcase carousel">
    <!-- Infinite Continuous Track Container -->
    <div class="reel-viewport" id="mentorship-reel-viewport">
      <div class="reel-track" id="mentorship-reel-track">
        {trackItems.map((item, index) => (
          <div class="reel-card" role="group" aria-label={`Mentorship Photo ${index % 8 + 1}: ${item.title}`}>
            <div class="card-inner">
              <img 
                src={item.image} 
                alt={`${item.title} - ${item.subtitle}`} 
                class="card-img" 
                loading="lazy" 
                decoding="async" 
                width="600" 
                height="800" 
              />
              <div class="card-gradient" aria-hidden="true"></div>
              
              <div class="card-info">
                <span class="card-tag">{item.tag}</span>
                <h3 class="card-title">{item.title}</h3>
                <p class="card-sub">{item.subtitle}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script src="../scripts/mentorship.ts"></script>
