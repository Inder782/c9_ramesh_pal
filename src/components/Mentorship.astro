---
// Mentorship.astro - Classroom, Live Trading Desk & Academy Mentorship Showcase
import config from '../data/config.json';

const mentorshipItems = [
  {
    image: '/images/mentorship/gallery-1.jpg',
    tag: 'Student Milestone',
    title: 'Felicitation & Trader Recognition',
    subtitle: 'Celebrating students who achieved strict risk discipline and consistent execution.'
  },
  {
    image: '/images/mentorship/gallery-2.jpg',
    tag: 'Academy Cohort',
    title: 'Batch Graduation & Honors',
    subtitle: 'Recognizing cohort participants completing rigorous market structure training.'
  },
  {
    image: '/images/mentorship/gallery-3.jpg',
    tag: 'Live Classroom',
    title: 'Interactive Chart & Volume Study',
    subtitle: 'In-person classroom sessions decoding supply-demand imbalances in real time.'
  },
  {
    image: '/images/mentorship/gallery-4.jpg',
    tag: 'Trading Floor',
    title: 'Multi-Screen Live Market Setup',
    subtitle: 'Live market execution environment monitoring index breadth and institutional flow.'
  },
  {
    image: '/images/mentorship/gallery-5.jpg',
    tag: 'Hands-on Workshop',
    title: 'In-Person Strategy Execution',
    subtitle: 'Step-by-step guidance on order sizing, stop placement, and trade management.'
  },
  {
    image: '/images/mentorship/gallery-6.jpg',
    tag: 'Technical Analysis',
    title: 'Chart Pattern & Zone Validation',
    subtitle: 'Deep-dive analysis of price action inflection points with academic precision.'
  },
  {
    image: '/images/mentorship/gallery-7.jpg',
    tag: 'Strategy Debrief',
    title: 'Post-Market Review & Journaling',
    subtitle: 'Analyzing trade outcomes, emotional triggers, and statistical edge refinement.'
  },
  {
    image: '/images/mentorship/gallery-8.jpg',
    tag: 'Mentorship',
    title: 'Trader Psychology & Capital Rules',
    subtitle: 'Instilling the uncompromising 1–2% capital risk rule for lasting market longevity.'
  }
];

// Duplicate items for infinite seamless looping
const trackItems = [...mentorshipItems, ...mentorshipItems];
---

<section class="mentorship-section" id="mentorship" aria-labelledby="mentorship-heading">
  <div class="container mentorship-header-container reveal-on-scroll">
    <div class="header-content">
      <span class="sub-label">ACADEMY &amp; FLOOR MENTORSHIP</span>
      <h2 id="mentorship-heading" class="section-title">
        Where Theory Meets Live Market Execution
      </h2>
      
      <!-- Highlighted Eyebrow Effect in One Line -->
      <div class="mentorship-eyebrow-line" role="note" aria-label="Mentorship Highlights">
        <span class="eyebrow-glow-dot" aria-hidden="true"></span>
        <span class="eyebrow-line-content">
          Offline Cohorts &amp; Workshops <span class="sep" aria-hidden="true">&bull;</span> Multi-Screen Trading Floor <span class="sep" aria-hidden="true">&bull;</span> Strict Capital Risk Discipline <span class="sep" aria-hidden="true">&bull;</span> Student Milestones
        </span>
      </div>

      <p class="section-description">
        Beyond theory and static books—hands-on offline classroom sessions, multi-screen live trading desk breakdowns, and real-time capital protection discipline.
      </p>
    </div>
  </div>

  <!-- Smooth Flowing Reel Stage -->
  <div class="reel-stage" id="mentorship-reel-stage" aria-label="Mentorship photo showcase carousel">
    <!-- Accessible Pause/Play Floating Control -->
    <button 
      type="button" 
      class="reel-toggle-btn" 
      id="mentorship-toggle-btn" 
      aria-label="Pause moving showcase gallery" 
      aria-pressed="false"
      title="Pause / Resume gallery motion"
    >
      <svg class="icon-pause" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
        <rect x="6" y="4" width="4" height="16" rx="1.5"></rect>
        <rect x="14" y="4" width="4" height="16" rx="1.5"></rect>
      </svg>
      <svg class="icon-play" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
        <path d="M7 4.5v15c0 .8.9 1.3 1.6.9l12-7.5c.7-.4.7-1.4 0-1.8l-12-7.5c-.7-.4-1.6.1-1.6.9z"></path>
      </svg>
      <span class="toggle-text" id="mentorship-toggle-text">Pause</span>
    </button>

    <!-- Infinite Continuous Track Container -->
    <div class="reel-viewport" id="mentorship-reel-viewport">
      <div class="reel-track" id="mentorship-reel-track">
        {trackItems.map((item, index) => (
          <div class="reel-card" role="group" aria-label={`Mentorship Photo ${index % 8 + 1}: ${item.title}`}>
            <div class="card-inner">
              <img 
                src={item.image} 
                alt={`${item.title} - ${item.subtitle}`} 
                class="card-img" 
                loading="lazy" 
                decoding="async" 
                width="600" 
                height="800" 
              />
              <div class="card-gradient" aria-hidden="true"></div>
              
              <div class="card-info">
                <span class="card-tag">{item.tag}</span>
                <h3 class="card-title">{item.title}</h3>
                <p class="card-sub">{item.subtitle}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .mentorship-section {
    padding: 72px 0 84px 0;
    background-color: var(--bg-tertiary);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    position: relative;
    overflow: hidden;
  }

  .mentorship-header-container {
    margin-bottom: 36px;
  }

  .header-content {
    max-width: 780px;
  }

  .sub-label {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-primary);
    margin-bottom: 10px;
  }

  .section-title {
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 12px 0;
  }

  .section-description {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Highlighted Eyebrow Banner (Single Sleek Line) */
  .mentorship-eyebrow-line {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, rgba(6, 78, 59, 0.08) 0%, rgba(16, 185, 129, 0.06) 100%);
    border: 1px solid rgba(6, 78, 59, 0.24);
    box-shadow: 0 2px 10px rgba(6, 78, 59, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    padding: 6px 18px;
    border-radius: 9999px;
    margin-bottom: 16px;
    max-width: 100%;
  }

  .eyebrow-glow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
    flex-shrink: 0;
  }

  .eyebrow-line-content {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .eyebrow-line-content::-webkit-scrollbar {
    display: none;
  }

  .eyebrow-line-content .sep {
    color: var(--accent-bronze);
    margin: 0 8px;
    opacity: 0.75;
  }


  /* ========================================================
     FLOWING REEL STAGE & INFINITE TRACK
     ======================================================== */
  .reel-stage {
    position: relative;
    width: 100%;
    margin-top: 10px;
    overflow: hidden;
  }

  /* Accessible Pause/Play Button */
  .reel-toggle-btn {
    position: absolute;
    top: -46px;
    right: 24px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px solid var(--border-light);
    padding: 5px 12px;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
    z-index: 10;
  }

  .reel-toggle-btn:hover {
    background: var(--accent-primary);
    color: #FFFFFF;
    border-color: var(--accent-primary);
  }

  .reel-toggle-btn .icon-play {
    display: none;
  }

  .reel-toggle-btn.is-paused .icon-pause {
    display: none;
  }

  .reel-toggle-btn.is-paused .icon-play {
    display: inline-block;
  }

  /* Viewport with smooth edge gradient fade masks */
  .reel-viewport {
    width: 100%;
    overflow: hidden;
    padding: 16px 0 24px 0;
    mask-image: linear-gradient(to right, transparent 0%, #000 4%, #000 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 4%, #000 96%, transparent 100%);
  }

  /* Smooth Infinite Hardware-Accelerated Gliding Track */
  .reel-track {
    display: flex;
    gap: 22px;
    width: max-content;
    will-change: transform;
    animation: smoothGlidingReel 52s linear infinite;
  }

  /* Pause smoothly when hovered, focused or user paused */
  .reel-stage:hover .reel-track,
  .reel-stage:focus-within .reel-track,
  .reel-track.is-paused {
    animation-play-state: paused;
  }

  @keyframes smoothGlidingReel {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Showcase Card */
  .reel-card {
    flex-shrink: 0;
    width: 320px;
    height: 420px;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    background: #0E161B;
    border: 1px solid rgba(17, 24, 39, 0.08);
    box-shadow: 0 10px 30px rgba(17, 24, 39, 0.08);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  }

  .reel-card:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 20px 42px rgba(17, 24, 39, 0.16);
    border-color: rgba(6, 78, 59, 0.3);
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reel-card:hover .card-img {
    transform: scale(1.05);
  }

  /* Deep Atmospheric Bottom Gradient for Perfect Readability */
  .card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(14, 22, 27, 0.02) 0%,
      rgba(14, 22, 27, 0.25) 45%,
      rgba(14, 22, 27, 0.75) 75%,
      rgba(14, 22, 27, 0.95) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Card Information Overlay */
  .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 22px 20px;
    z-index: 2;
    color: #FFFFFF;
  }

  .card-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(6, 78, 59, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #A3D9C9;
    border: 1px solid rgba(163, 217, 201, 0.3);
    padding: 3px 10px;
    border-radius: 9999px;
    margin-bottom: 8px;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
    color: #FFFFFF;
    margin: 0 0 6px 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .card-sub {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #D1D5DB;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  /* ========================================================
     RESPONSIVE STYLING (PERFECT MOBILE EXPERIENCE)
     ======================================================== */
  @media (max-width: 768px) {
    .mentorship-section {
      padding: 48px 0 60px 0;
    }

    .mentorship-header-container {
      margin-bottom: 24px;
    }

    .section-title {
      font-size: 1.85rem;
    }

    .section-description {
      font-size: 0.95rem;
      margin-bottom: 18px;
    }

    .mentorship-eyebrow-line {
      padding: 5px 14px;
      gap: 7px;
      margin-bottom: 12px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .eyebrow-line-content {
      font-size: 0.72rem;
      letter-spacing: 0.03em;
    }

    .eyebrow-line-content .sep {
      margin: 0 5px;
    }

    .reel-toggle-btn {
      position: static;
      margin-bottom: 14px;
      margin-left: auto;
      margin-right: 16px;
      display: flex;
    }

    .reel-card {
      width: 260px;
      height: 350px;
      border-radius: 16px;
    }

    .reel-track {
      gap: 14px;
      animation-duration: 44s;
    }

    .card-info {
      padding: 16px 14px;
    }

    .card-title {
      font-size: 1rem;
    }

    .card-sub {
      font-size: 0.75rem;
    }

    .reel-viewport {
      mask-image: linear-gradient(to right, transparent 0%, #000 2%, #000 98%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 2%, #000 98%, transparent 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel-track {
      animation: none;
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 12px;
    }

    .reel-stage:hover .reel-track {
      animation-play-state: initial;
    }

    .reel-toggle-btn {
      display: none;
    }
  }
</style>

<script>
  // Mentorship Gallery Pause/Play Toggle Controller
  const toggleBtn = document.getElementById('mentorship-toggle-btn');
  const toggleText = document.getElementById('mentorship-toggle-text');
  const reelTrack = document.getElementById('mentorship-reel-track');

  let isPaused = false;

  function setPausedState(paused: boolean) {
    isPaused = paused;
    if (reelTrack) {
      if (isPaused) {
        reelTrack.classList.add('is-paused');
      } else {
        reelTrack.classList.remove('is-paused');
      }
    }
    if (toggleBtn) {
      toggleBtn.setAttribute('aria-pressed', String(isPaused));
      if (isPaused) {
        toggleBtn.classList.add('is-paused');
      } else {
        toggleBtn.classList.remove('is-paused');
      }
    }
    if (toggleText) {
      toggleText.textContent = isPaused ? 'Resume' : 'Pause';
    }
  }

  toggleBtn?.addEventListener('click', () => {
    setPausedState(!isPaused);
  });
</script>
