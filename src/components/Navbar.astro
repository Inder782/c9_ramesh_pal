---
import config from '../data/config.json';
import '../styles/components/navbar.css';

const phoneDigits = config.phone.replace(/[^0-9]/g, '');
const whatsappCta = config.whatsappUrl || `https://wa.me/${phoneDigits}`;
---

<div class="nav-wrapper">
  <header class="floating-header is-on-hero" id="main-header" role="banner">
    <div class="nav-container">
      <!-- Brand Logo -->
      <a href="#home" class="brand-link" aria-label={`${config.brandName} Home`}>
        <img src="/images/logo.png" alt={`${config.brandName} Logo`} class="brand-logo-img logo-dark" width="160" height="36" />
        <img src="/images/logo-light.png" alt={`${config.brandName} Logo`} class="brand-logo-img logo-light" width="160" height="36" />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="desktop-nav" role="navigation" aria-label="Main Navigation">
        <ul class="nav-list" id="main-nav-list">
          <div class="sliding-pill" id="sliding-pill" aria-hidden="true"></div>
          
          <li><a href="#home" class="nav-link pill-active">Home</a></li>
          <li><a href="#about" class="nav-link">About</a></li>
          <li><a href="#offerings" class="nav-link">Offerings</a></li>
          <li><a href="#compliance" class="nav-link">Compliance</a></li>
          <li><a href="#regulatory" class="nav-link">Investor Data</a></li>
        </ul>
      </nav>

      <!-- Header Actions -->
      <div class="nav-actions">
        <a href={whatsappCta} target="_blank" rel="noopener noreferrer" class="btn-lean-cta" aria-label="Consult Analyst">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          <span>Consult Analyst</span>
        </a>

        <!-- Mobile Hamburger Trigger -->
        <button class="hamburger-btn" id="nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
          <span class="hamburger-bar" aria-hidden="true"></span>
          <span class="hamburger-bar" aria-hidden="true"></span>
          <span class="hamburger-bar" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </header>
</div>

<!-- Mobile Navigation Drawer & Backdrop (Rendered outside fixed wrapper) -->
<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
<aside class="mobile-drawer" id="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation" aria-hidden="true" inert>
  <div class="drawer-head">
    <a href="#home" class="brand-link" aria-label={`${config.brandName} Home`}>
      <img src="/images/logo.png" alt={`${config.brandName} Logo`} class="drawer-logo-img" width="140" height="32" />
    </a>
    <button class="drawer-close" id="drawer-close" type="button" aria-label="Close navigation menu">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="drawer-nav" role="navigation" aria-label="Mobile Navigation Links">
    <ul class="drawer-links">
      <li><a href="#home" class="drawer-link">Home</a></li>
      <li><a href="#about" class="drawer-link">About</a></li>
      <li><a href="#offerings" class="drawer-link">Offerings</a></li>
      <li><a href="#compliance" class="drawer-link">Compliance</a></li>
      <li><a href="#regulatory" class="drawer-link">Investor Data</a></li>
    </ul>
  </nav>

  <div class="drawer-foot">
    <div class="drawer-sebi-badge">
      <span class="sebi-tag">SEBI RA</span>
      <span class="sebi-num">{config.sebiRegNo}</span>
    </div>
    <a href={whatsappCta} target="_blank" rel="noopener noreferrer" class="btn-primary w-full">
      Consult on WhatsApp
    </a>
  </div>
</aside>

<script src="../scripts/navbar.ts"></script>
