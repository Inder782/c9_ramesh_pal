---
// TickerTape.astro - Live Stock Market Inflection Ticker with WCAG 2.2.2 Controls
---

<section class="ticker-section" aria-label="Live Market Ticker">
  <div class="ticker-wrapper" id="ticker-wrapper">
    <!-- Accessible Pause/Resume Control -->
    <div class="ticker-control-container">
      <button 
        id="ticker-toggle-btn" 
        class="ticker-control-btn" 
        type="button" 
        aria-label="Pause scrolling stock ticker" 
        aria-pressed="false" 
        aria-controls="ticker-track-container" 
        title="Pause scrolling stock ticker"
      >
        <span class="ticker-btn-icon" aria-hidden="true">
          <svg class="icon-pause" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <rect x="6" y="4" width="4" height="16" rx="1.5"></rect>
            <rect x="14" y="4" width="4" height="16" rx="1.5"></rect>
          </svg>
          <svg class="icon-play" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path d="M7 4.5v15c0 .8.9 1.3 1.6.9l12-7.5c.7-.4.7-1.4 0-1.8l-12-7.5c-.7-.4-1.6.1-1.6.9z"></path>
          </svg>
        </span>
        <span class="ticker-btn-text" id="ticker-btn-text">Pause</span>
      </button>
      <span id="ticker-status-announcer" class="sr-only" aria-live="polite">Stock ticker is scrolling</span>
    </div>

    <!-- Scrolling Ticker Container -->
    <div class="ticker-track-container" id="ticker-track-container">
      <div class="tradingview-widget-container" id="tv-ticker-container">
        <div class="tradingview-widget-container__widget"></div>
      </div>

      <!-- Accessible Paused State Overlay -->
      <div 
        id="ticker-paused-overlay" 
        class="ticker-paused-overlay" 
        tabindex="0" 
        role="button" 
        aria-label="Stock ticker paused. Click to resume scrolling."
      >
        <span class="ticker-paused-badge">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M7 4.5v15c0 .8.9 1.3 1.6.9l12-7.5c.7-.4.7-1.4 0-1.8l-12-7.5c-.7-.4-1.6.1-1.6.9z"></path>
          </svg>
          Ticker Paused <span aria-hidden="true">&bull;</span> Click to Resume
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .ticker-section {
    position: relative;
    z-index: 10;
    background-color: var(--dark-surface);
    border-top: 1px solid rgba(226, 232, 240, 0.1);
    border-bottom: 1px solid rgba(226, 232, 240, 0.1);
    overflow: hidden;
  }

  .ticker-wrapper {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 46px;
    position: relative;
  }

  .ticker-control-container {
    background: #0B0F19;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    height: 100%;
    min-height: 46px;
    display: flex;
    align-items: center;
    padding: 0 14px;
    z-index: 12;
    flex-shrink: 0;
  }

  .ticker-control-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #1E293B;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #F8FAFC;
    padding: 5px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.03em;
    transition: all 0.2s ease;
  }

  .ticker-control-btn:hover {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #FFFFFF;
  }

  .ticker-btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-pause {
    display: block;
  }

  .icon-play {
    display: none;
  }

  .ticker-track-container {
    flex: 1;
    position: relative;
    overflow: hidden;
    height: 46px;
  }

  .tradingview-widget-container {
    width: 100%;
    height: 100%;
  }

  .tradingview-widget-container iframe {
    height: 46px !important;
  }

  /* Paused State */
  .ticker-paused-overlay {
    display: none;
    position: absolute;
    inset: 0;
    background: rgba(11, 15, 25, 0.9);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 15;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .ticker-wrapper.ticker-paused .ticker-paused-overlay {
    display: flex;
  }

  .ticker-wrapper.ticker-paused .icon-pause {
    display: none;
  }

  .ticker-wrapper.ticker-paused .icon-play {
    display: block;
  }

  .ticker-wrapper.ticker-paused .tradingview-widget-container {
    filter: grayscale(0.6) opacity(0.35);
    pointer-events: none;
  }

  .ticker-paused-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(6, 95, 70, 0.3);
    border: 1px solid var(--accent-primary);
    color: #A7F3D0;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 14px;
    border-radius: 9999px;
  }

  @media (max-width: 640px) {
    .ticker-control-container {
      padding: 0 8px;
    }
    .ticker-control-btn {
      padding: 4px 8px;
      font-size: 0.7rem;
    }
  }
</style>

<script>
  function loadTradingViewWidget() {
    const container = document.getElementById('tv-ticker-container');
    if (!container || container.querySelector('script')) return;

    const script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js';
    script.async = true;
    script.innerHTML = JSON.stringify({
      symbols: [
        { proName: "BSE:SENSEX", title: "S&P BSE SENSEX" },
        { proName: "NSE:NIFTY", title: "NIFTY 50" },
        { proName: "BSE:RELIANCE", title: "Reliance" },
        { proName: "BSE:HDFCBANK", title: "HDFC Bank" },
        { proName: "BSE:TCS", title: "TCS" },
        { proName: "BSE:INFY", title: "Infosys" },
        { proName: "BSE:ICICIBANK", title: "ICICI Bank" },
        { proName: "BSE:LT", title: "L&T" },
        { proName: "BSE:BHARTIARTL", title: "Bharti Airtel" },
        { proName: "BSE:ITC", title: "ITC" }
      ],
      showSymbolLogo: true,
      colorTheme: "dark",
      isTransparent: true,
      displayMode: "regular",
      locale: "in"
    });
    container.appendChild(script);
  }

  function initTickerControl() {
    loadTradingViewWidget();

    const wrapper = document.getElementById('ticker-wrapper');
    const toggleBtn = document.getElementById('ticker-toggle-btn');
    const btnText = document.getElementById('ticker-btn-text');
    const announcer = document.getElementById('ticker-status-announcer');
    const pausedOverlay = document.getElementById('ticker-paused-overlay');

    if (!wrapper || !toggleBtn) return;

    let isPaused = false;

    function setPaused(paused: boolean) {
      isPaused = paused;
      if (isPaused) {
        wrapper?.classList.add('ticker-paused');
        toggleBtn?.setAttribute('aria-pressed', 'true');
        toggleBtn?.setAttribute('aria-label', 'Resume scrolling stock ticker');
        toggleBtn?.setAttribute('title', 'Resume scrolling stock ticker');
        if (btnText) btnText.textContent = 'Resume';
        if (announcer) announcer.textContent = 'Stock ticker paused';
      } else {
        wrapper?.classList.remove('ticker-paused');
        toggleBtn?.setAttribute('aria-pressed', 'false');
        toggleBtn?.setAttribute('aria-label', 'Pause scrolling stock ticker');
        toggleBtn?.setAttribute('title', 'Pause scrolling stock ticker');
        if (btnText) btnText.textContent = 'Pause';
        if (announcer) announcer.textContent = 'Stock ticker is scrolling';
      }
    }

    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      setPaused(!isPaused);
    });

    if (pausedOverlay) {
      pausedOverlay.addEventListener('click', () => {
        setPaused(false);
        toggleBtn.focus();
      });
      pausedOverlay.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setPaused(false);
          toggleBtn.focus();
        }
      });
    }

    // Support prefers-reduced-motion
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (motionQuery.matches) {
      setPaused(true);
    }
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initTickerControl)
    : initTickerControl();
</script>
