---
// TickerTape.astro - Live Stock Market Inflection Ticker with WCAG 2.2.2 Controls
import '../styles/components/ticker-tape.css';
---

<section class="ticker-section" aria-label="Live Market Ticker">
  <div class="ticker-wrapper" id="ticker-wrapper">
    <!-- Accessible Pause/Resume Control -->
    <div class="ticker-control-container">
      <button 
        id="ticker-toggle-btn" 
        class="ticker-control-btn" 
        type="button" 
        aria-label="Pause ticker" 
        aria-pressed="false" 
        aria-controls="ticker-track-container" 
        title="Pause ticker"
      >
        <span class="ticker-btn-icon" aria-hidden="true">
          <svg class="icon-pause" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <rect x="6" y="4" width="4" height="16" rx="1.5"></rect>
            <rect x="14" y="4" width="4" height="16" rx="1.5"></rect>
          </svg>
          <svg class="icon-play" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path d="M7 4.5v15c0 .8.9 1.3 1.6.9l12-7.5c.7-.4.7-1.4 0-1.8l-12-7.5c-.7-.4-1.6.1-1.6.9z"></path>
          </svg>
        </span>
        <span class="ticker-btn-text" id="ticker-btn-text">Pause ticker</span>
      </button>
      <span id="ticker-status-announcer" class="sr-only" aria-live="polite">Stock ticker is scrolling</span>

      <!-- Accessible Market Data Alternative Link for Screen Reader & Keyboard Navigation -->
      <a 
        href="https://www.bseindia.com/markets.html" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="ticker-alt-link"
        aria-label="View live market data on BSE India (accessible alternative)"
      >
        View live market data on BSE India
      </a>
    </div>

    <!-- Scrolling Ticker Container -->
    <div class="ticker-track-container" id="ticker-track-container">
      <div class="tradingview-widget-container" id="tv-ticker-container">
        <div class="tradingview-widget-container__widget"></div>
      </div>

      <!-- Accessible Paused State Overlay with Movement Stopped & On-demand values check -->
      <div 
        id="ticker-paused-overlay" 
        class="ticker-paused-overlay" 
        role="region" 
        aria-label="Stock ticker paused display"
      >
        <div class="ticker-paused-content">
          <button 
            id="ticker-resume-overlay-btn"
            type="button"
            class="ticker-paused-badge"
            aria-label="Ticker Paused Play ticker"
          >
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="M7 4.5v15c0 .8.9 1.3 1.6.9l12-7.5c.7-.4.7-1.4 0-1.8l-12-7.5c-.7-.4-1.6.1-1.6.9z"></path>
            </svg>
            <span>Ticker Paused <span aria-hidden="true">&bull;</span> Play ticker</span>
          </button>
          <a 
            href="https://www.bseindia.com/markets.html" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="ticker-paused-ondemand-link"
            aria-label="Check current values on BSE India (opens in new tab)"
          >
            Check current values on BSE India <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>


<script src='../scripts/ticker-tape.ts'></script>
