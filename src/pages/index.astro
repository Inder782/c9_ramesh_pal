---
import Layout from '../layouts/Layout.astro';
import DisclaimerOverlay from '../components/DisclaimerOverlay.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TickerTape from '../components/TickerTape.astro';
import About from '../components/About.astro';
import Pricing from '../components/Pricing.astro';
import Mentorship from '../components/Mentorship.astro';
import InvestorCharter from '../components/InvestorCharter.astro';
import Compliance from '../components/Compliance.astro';
import Regulatory from '../components/Regulatory.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Mandatory SEBI Initial Risk Warning Overlay -->
  <DisclaimerOverlay />

  <!-- Premium Lean Floating Pill Header -->
  <Navbar />

  <!-- Main Content Area for Skip Link Target -->
  <main id="main-content" role="main" tabindex="-1">
    <Hero />
    <TickerTape />
    <About />
    <Pricing />
    <Mentorship />
    <InvestorCharter />
    <Compliance />
    <Regulatory />
  </main>

  <!-- 5-Tier Institutional Trust Footer & Legal Modals -->
  <Footer />
</Layout>
